#!/bin/sh
# fraim — the operational layer for agent-driven projects.
#
# Owns state and lifecycle: what is installed where, which projects exist,
# how much drift each has accumulated. It does NOT serve procedure text —
# the agent reads that from the skill files on disk, because a 20 KB
# procedure through stdout gets truncated by some harnesses, and because in
# CI or a web session the CLI may not be installed while the file still is.

set -eu

_self=$0
# install.sh always installs fraim as a symlink into ~/.local/bin, so $0 is
# the link, not the file — resolve the chain before deriving lib/ from it,
# or every installed command breaks with "no such file".
while [ -L "$_self" ]; do
    _link=$(readlink -- "$_self")
    case $_link in
        /*) _self=$_link ;;
        *)  _self=$(dirname -- "$_self")/$_link ;;
    esac
done
_libdir=$(cd -- "$(dirname -- "$_self")/../lib" 2>/dev/null && pwd -P) || {
    printf 'fraim: не найден каталог lib/ рядом с исполняемым файлом\n' >&2
    exit 2
}

# shellcheck source=../lib/core.sh
. "$_libdir/core.sh"
. "$_libdir/skills.sh"
. "$_libdir/harness.sh"
. "$_libdir/ade.sh"
. "$_libdir/registry.sh"
. "$_libdir/context.sh"
. "$_libdir/config.sh"
. "$_libdir/scaffold.sh"
. "$_libdir/verbs.sh"
. "$_libdir/watchman.sh"
. "$_libdir/clean.sh"
. "$_libdir/publish.sh"
. "$_libdir/update.sh"
. "$_libdir/roles.sh"
. "$_libdir/fleet.sh"
. "$_libdir/dispatch.sh"
. "$_libdir/menu.sh"

usage() {
    cat <<'USAGE'
fraim — эксплуатационный слой для проектов на агентах

Это набираешь ты
  fraim                     меню (в терминале) — то же, что fraim menu
  fraim menu                экран со сканом, обновлением, доктором, реестром
  fraim status [ПУТЬ]       что происходит в проекте (--json для машины)
  fraim fleet [ПУТЬ]        где живёт работа: чекауты проекта и среда флота
  fraim undo [ХЕШ]          показать точки сохранения / вернуть, как было
  fraim scaffold [ПУТЬ]     завести проект под систему
  fraim upgrade [ПУТЬ]      довести существующий фундамент до стандарта
  fraim clean [--yes]       прибрать всё, что чинится без суждения
  fraim publish [--check]   копия проекта вне этой машины: создать, отправить, сверить
                            (--brief — задание агенту вычистить найденное)
  fraim dispatch ПЛАН       режим флота: проверить план и завести сборку
  fraim dispatch collect СБОРКА  свести волну в ветку сборки
  fraim dispatch accept СБОРКА   приёмка дирижёра: сверка, проверка, чистка, ствол
                            run СБОРКА — поднять флот в среде исполнения
                            watch СБОРКА — что среда говорит о воркерах
                            verify СБОРКА ПОДЗАДАЧА — сверить дерево с путями
                            check ПЛАН · accept СБОРКА · list
  fraim mode [reactive|fleet] режим проекта: агент сам или дирижёр с флотом
  fraim roles [set [ИМЯ]]   таблица ролей: во что разворачивается роль на этой машине
                            (set — выбрать агента, модель и усилие из списка)
  fraim init                поставить скиллы / подхватить новый харнес
  fraim update [--check]    привезти новую версию и разложить (--check — только узнать;
                            --quiet — для автозапуска: молча, и никогда не мешает старту)
  fraim doctor              что и куда установлено, что разошлось
  fraim config              что действует и откуда (set КЛЮЧ ЗНАЧЕНИЕ)
  fraim projects            реестр проектов (add ПУТЬ / rm ПУТЬ)

Это зовут процедуры — тебе их помнить не нужно
  fraim task-new СЛАГ       папка задачи + штамп provenance
  fraim task-block СЛАГ     завести blockers.md по шаблону
  fraim task-result СЛАГ    завести result.md (--reconcile / --reset)
  fraim task-revise СЛАГ ДЕФЕКТ ИСПРАВЛЕНО   ревизия плана
  fraim plan-seal СЛАГ      проверить план перед выдачей исполнителю
  fraim decide ЗАГОЛОВОК    запись в DECISIONS.md (тело — потоком)
  fraim pitfall СТРОКА...   грабли в CONVENTIONS.md
  fraim task-seal СЛАГ      проверить и заархивировать исполненную задачу
  fraim reconcile-seal СЛАГ то же для дрейфнувшей сессии
  fraim investigate-new СЛАГ   папка расследования + findings.md
  fraim investigate-seal СЛАГ  проверить исход и уборку, заархивировать
  fraim prune-mark          сбросить счётчик дрейфа маркером
  fraim stack-passport      создать STACK.md из шаблона
  fraim commit ВИД ТЕКСТ ПУТЬ...   точка сохранения по перечисленным путям
  fraim restore ПУТЬ...     вернуть перечисленные пути к последней точке

Служебное
  fraim show ИМЯ            напечатать текст процедуры
  fraim build               пересобрать артефакты репозитория
  fraim version             версия
  fraim help                этот экран

Сторож детерминированный: файлы, git log и mtime. Ни модели, ни сети, ничего
не пишет. Он замечает — решает человек.
USAGE
}

# --- init -------------------------------------------------------------------
cmd_init() {
    _root=$(fraim_root) || die "не найден каталог procedures/ — установка повреждена"
    _ver=$(fraim_version)
    say "fraim $_ver · источник: $_root"
    say ""

    _build=$(skills_build)
    _n=$(find "$_build" -name SKILL.md | wc -l | tr -d ' ')
    ok "собрано скиллов: $_n (процедуры + мастер-скилл)"

    registry_init

    harness_detect | while IFS='	' read -r _key _label _skills _instr; do
        [ -n "$_key" ] || continue
        _count=$(harness_install "$_label" "$_skills" "$_build") || {
            warn "$_label: установка не удалась"
            continue
        }
        ok "$_label → $_skills ($_count)"
        if [ -n "$_instr" ]; then
            if context_install "$_instr"; then
                dim "    контекстный блок → $_instr"
            else
                warn "$_label: не удалось обновить $_instr"
            fi
        fi
    done
    _found=$(harness_detect | wc -l | tr -d ' ')

    if [ "$_found" -eq 0 ]; then
        say ""
        warn "ни один харнес не найден"
        dim "    скиллы собраны в $_build — скопируй их в каталог своего агента вручную,"
        dim "    или установи харнес и запусти 'fraim init' ещё раз (команда идемпотентна)."
    fi

    # Register the current project if it is under the system. bootstrap and
    # onboard both end here too, so the registry fills itself as projects
    # come under the system rather than by hand.
    _cwd=$(pwd -P)
    if project_is_managed "$_cwd"; then
        registry_add "$_cwd" && ok "проект зарегистрирован: $_cwd"
        # The PROJECT block, not the machine one. They share the marker pair, so writing
        # the machine block here would have overwritten what `fraim scaffold` puts in a
        # project's AGENTS.md — and it would be the wrong text anyway: a routing table for
        # skills installed on this machine says nothing to the agent that clones the repo.
        CTX_ROOT=$_cwd
        if context_install "$_cwd/AGENTS.md" context_project_block; then
            dim "    контекстный блок → $_cwd/AGENTS.md"
        fi
    fi

    claude_permission_hint

    # Единственное место в init, где есть сеть, и оно необязательное: узнать, не вышло
    # ли уже что-то новее. Молча и не чаще, чем раз в update_check_days; отказ сети
    # ничего не ломает. Сторож потом прочитает готовый ответ из кэша, сам никуда не идя.
    update_probe_if_due
    if [ "$(update_state)" = behind ]; then
        say ""
        warn "$(update_line)"
    fi

    say ""
    say "Готово. Проверить: ${C_BLD}fraim doctor${C_OFF}"
}

# --- update -----------------------------------------------------------------
# `fraim init` раскладывает то, что уже лежит на диске. `fraim update` сначала
# привозит новое, потом раскладывает — и это две разные команды, потому что init
# нужен ещё и просто так: поставил новый харнес → init, сеть не при чём.
#
# --check ничего не меняет и годится для расписания: exit 1, если отстали.
cmd_update() {
    case ${1:-} in
        --check)
            if ! update_src_is_clone; then
                warn "источник — не git-клон, проверять нечего"
                return 0
            fi
            update_probe || :
            case $(update_state) in
                behind)  warn "$(update_line)"; return 1 ;;
                ahead)   ok "$(update_line)"; return 0 ;;
                unknown) warn "$(update_line)"
                         dim "    сеть или доступ к репозиторию: проверь git ls-remote"
                         return 1 ;;
                *)       ok "установлена последняя версия ($(fraim_version))"; return 0 ;;
            esac ;;
        --quiet)
            # For an image or a VM recipe: run at every start, say nothing when there is
            # nothing to say, and NEVER stand between the human and their session.
            #
            # Every failure path here exits 0 on purpose. A dead network, a private repo
            # without credentials, a source that is not a clone — none of those are reasons
            # to stop an agent from starting. Working on a version one commit old beats not
            # working at all, and the person finds out from `fraim version` either way.
            update_src_is_clone || exit 0
            update_probe >/dev/null 2>&1 || exit 0
            [ "$(update_state)" = behind ] || exit 0
            _u_before=$(fraim_version)
            if update_apply >/dev/null 2>&1; then
                ok "fraim обновлён: $_u_before → $(fraim_version)"
                exec "$(update_src)/installer/bin/fraim" init >/dev/null 2>&1
            fi
            exit 0
            ;;
        "") ;;
        *)  die "fraim update: неизвестный ключ: $1" ;;
    esac

    say "Обновление fraim"
    say ""
    _u_before=$(fraim_version)
    update_apply || return 1
    say ""
    # Новый бинарник, новые lib/, новые процедуры — и только теперь раскладка.
    # В этом процессе продолжать нельзя: он прочитал lib/ до обновления.
    _u_bin="$(update_src)/installer/bin/fraim"
    dim "  было: $_u_before"
    exec "$_u_bin" init
}

# Claude Code gates shell calls, so without a standing permission the control
# panel hits an approval prompt on every status check. We only touch settings
# when a JSON-safe editor is available; otherwise we print the line and let
# the human add it, per the system's own rule about host-level config.
claude_permission_hint() {
    _settings="$HOME/.claude/settings.json"
    [ -d "$HOME/.claude" ] || return 0
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$_settings" <<'PY' && return 0
import json, os, sys
path = sys.argv[1]
try:
    with open(path) as f:
        data = json.load(f)
except FileNotFoundError:
    data = {}
except (json.JSONDecodeError, OSError):
    sys.exit(1)
if not isinstance(data, dict):
    sys.exit(1)
perms = data.setdefault("permissions", {})
allow = perms.setdefault("allow", [])
rule = "Bash(fraim:*)"
if rule in allow:
    sys.exit(0)
allow.append(rule)
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".fraim.tmp"
with open(tmp, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
print("  разрешение Bash(fraim:*) добавлено в ~/.claude/settings.json")
PY
    fi
    dim "    Claude Code: добавь \"Bash(fraim:*)\" в permissions.allow в ~/.claude/settings.json"
    return 0
}

# --- status -----------------------------------------------------------------
cmd_status() {
    _json=0; _path=
    for _a in "$@"; do
        case $_a in
            --json) _json=1 ;;
            -*) die "неизвестный флаг: $_a" ;;
            *) _path=$_a ;;
        esac
    done
    [ -n "$_path" ] || _path=$(pwd -P)
    _root=$(cd -- "$_path" 2>/dev/null && pwd -P) || die "нет такого каталога: $_path"

    if ! wm_managed "$_root"; then
        if [ "$_json" = 1 ]; then
            printf '{ "project": "%s", "status": "unmanaged", "findings": [] }\n' "$_root"
        else
            warn "$_root не под системой: нет ни ai/, ни ARCHITECTURE.md"
            dim "    завести существующий проект — /onboard; новый — /design-session → /bootstrap"
        fi
        exit 2
    fi

    wm_run "$_root"
    if [ "$_json" = 1 ]; then wm_report_json "$_root"; else wm_report_human "$_root"; fi
    if wm_has_attention; then exit 1; fi
    exit 0
}

# --- fleet ------------------------------------------------------------------
# Read-only, like `status`: where the work of this project actually lives.
#
# The register of checkouts is git, not the ADE, so this answers even with no fleet
# runtime installed — and that is the common case today. The environment section only
# adds what git cannot know: whether a runtime is answering, and whether something is
# scheduled against this project.

# Task counts for one checkout: runnable<TAB>blocked<TAB>unsealed
fleet_counts() {
    _f_root=$1; _f_run=0; _f_blk=0; _f_uns=0
    for _f_t in "$_f_root"/ai/tasks/*/; do
        [ -d "$_f_t" ] || continue
        [ -f "$_f_t/task.md" ] || continue
        if   [ -f "$_f_t/blockers.md" ]; then _f_blk=$((_f_blk + 1))
        elif [ -f "$_f_t/result.md" ];   then _f_uns=$((_f_uns + 1))
        else _f_run=$((_f_run + 1))
        fi
    done
    printf '%s\t%s\t%s\n' "$_f_run" "$_f_blk" "$_f_uns"
}

fleet_state_words() {
    _fs_run=$1; _fs_blk=$2; _fs_uns=$3; _fs_out=
    [ "$_fs_blk" -gt 0 ] && _fs_out="$_fs_blk заблокировано"
    if [ "$_fs_uns" -gt 0 ]; then
        [ -n "$_fs_out" ] && _fs_out="$_fs_out, "
        _fs_out="$_fs_out$_fs_uns не запечатано"
    fi
    if [ "$_fs_run" -gt 0 ]; then
        [ -n "$_fs_out" ] && _fs_out="$_fs_out, "
        _fs_out="$_fs_out$_fs_run в очереди"
    fi
    [ -n "$_fs_out" ] || _fs_out="чисто"
    printf '%s\n' "$_fs_out"
}

cmd_fleet() {
    _json=0; _path=
    for _a in "$@"; do
        case $_a in
            --json) _json=1 ;;
            -*) die "неизвестный флаг: $_a" ;;
            *) _path=$_a ;;
        esac
    done
    [ -n "$_path" ] || _path=$(pwd -P)
    _root=$(cd -- "$_path" 2>/dev/null && pwd -P) || die "нет такого каталога: $_path"
    verb_is_git "$_root" || die "$_root не репозиторий — чекаутов нет и быть не может"

    _list=$(git -C "$_root" worktree list --porcelain 2>/dev/null) || _list=

    [ "$_json" = 1 ] || printf '%s%s%s\n' "$C_BLD" "$(basename -- "$_root")" "$C_OFF"
    [ "$_json" = 1 ] && printf '{\n  "project": "%s",\n  "checkouts": [' "$_root"

    _old_ifs=$IFS
    set -f
    IFS='
'
    _first=1
    for _p in $(printf '%s\n' "$_list" | sed -n 's/^worktree //p'); do
        [ -d "$_p" ] || continue
        _real=$(cd -- "$_p" 2>/dev/null && pwd -P) || continue
        set +f                      # fleet_counts globs; `set -f` above would mute it
        _c=$(fleet_counts "$_real")
        set -f
        _run=$(printf '%s' "$_c" | cut -f1)
        _blk=$(printf '%s' "$_c" | cut -f2)
        _uns=$(printf '%s' "$_c" | cut -f3)
        _here=false; [ "$_real" = "$_root" ] && _here=true
        if [ "$_json" = 1 ]; then
            [ "$_first" = 1 ] || printf ','
            _first=0
            printf '\n    { "path": "%s", "current": %s, "runnable": %s, "blocked": %s, "unsealed": %s }' \
                "$(wm_json_escape "$_real")" "$_here" "$_run" "$_blk" "$_uns"
        else
            _mark='  '; [ "$_here" = true ] && _mark=' ▸'
            printf '%s %s  %s%s%s\n' "$_mark" "$(wm_pad "$_real" 48)" \
                "$C_DIM" "$(fleet_state_words "$_run" "$_blk" "$_uns")" "$C_OFF"
        fi
    done
    IFS=$_old_ifs
    set +f

    [ "$_json" = 1 ] && printf '\n  ],\n  "ade": ['

    # The environment, when there is one. Absence is silence: an ADE is the operator's
    # choice, and a project without one is not a project with a problem (C1).
    _det=$(ade_detect)
    _old_ifs=$IFS
    IFS='
'
    _first=1
    for _row in $_det; do
        _label=$(printf '%s' "$_row" | cut -f2)
        _key=$(printf '%s' "$_row" | cut -f1)
        _cmd=$(printf '%s' "$_row" | cut -f3)
        if ade_alive "$_cmd"; then _alive=true; else _alive=false; fi
        _auto=none
        if [ "$_alive" = true ]; then
            _a=$(ade_automations "$_cmd" "$_root")
            if [ "$(printf '%s' "$_a" | cut -f1)" = 1 ]; then
                if [ "$(printf '%s' "$_a" | cut -f2)" = 1 ]; then _auto=watchman; else _auto=free; fi
            fi
        fi
        if [ "$_json" = 1 ]; then
            [ "$_first" = 1 ] || printf ','
            _first=0
            printf '\n    { "key": "%s", "command": "%s", "alive": %s, "automations": "%s" }' \
                "$_key" "$(wm_json_escape "$_cmd")" "$_alive" "$_auto"
        else
            if [ "$_alive" = true ]; then
                ok "$_label ($_cmd) — рантайм отвечает"
            else
                dim "  $_label ($_cmd) — установлен, рантайм не отвечает"
            fi
            case $_auto in
                free) warn "$_label: по этому проекту работает агент по расписанию — проверь, что он не правит код без тебя" ;;
                watchman) dim "  $_label: по расписанию ходит сторож — это наблюдение, не правка" ;;
            esac
        fi
    done
    IFS=$_old_ifs

    if [ "$_json" = 1 ]; then
        printf '\n  ]\n}\n'
    elif [ -z "$_det" ]; then
        dim "  среда исполнения флота на этой машине не найдена"
    fi
    exit 0
}

# --- projects ---------------------------------------------------------------
cmd_projects() {
    registry_init
    case ${1:-list} in
        list|"")
            _any=0
            registry_list | while read -r _p; do
                [ -n "$_p" ] || continue
                if [ -d "$_p" ]; then say "  $_p"; else printf '  %s%s  (нет каталога)%s\n' "$C_DIM" "$_p" "$C_OFF"; fi
            done
            _any=$(registry_list | wc -l | tr -d ' ')
            if [ "$_any" -eq 0 ]; then
                dim "  реестр пуст — 'fraim projects add ПУТЬ' или запусти 'fraim init' в проекте"
            fi
            ;;
        add) [ $# -ge 2 ] || die "укажи путь"; registry_add "$2" && ok "добавлено: $2" ;;
        rm)  [ $# -ge 2 ] || die "укажи путь"; registry_rm "$2" && ok "убрано: $2" ;;
        *)   die "неизвестная подкоманда: $1" ;;
    esac
}

# --- doctor -----------------------------------------------------------------
cmd_doctor() {
    _ver=$(fraim_version)
    _root=$(fraim_root) || die "не найден каталог procedures/"
    say "${C_BLD}fraim $_ver${C_OFF}"
    if git -C "$_root" rev-parse --git-dir >/dev/null 2>&1; then
        say "  источник:  $_root ($(git -C "$_root" rev-parse --abbrev-ref HEAD 2>/dev/null) $(git -C "$_root" rev-parse --short HEAD 2>/dev/null), $(git -C "$_root" log -1 --format=%cd --date=short 2>/dev/null))"
    else
        say "  источник:  $_root"
    fi
    say "  состояние: $FRAIM_HOME"
    # Единственная сеть в докторе, и она уместна: доктор для того и зовётся, чтобы
    # узнать, всё ли на месте, а «вышло ли что-то новее» — часть этого вопроса.
    update_probe_if_due
    case $(update_state) in
        behind|unknown) warn "  $(update_line)" ;;
        ahead)          dim "  $(update_line)" ;;
        *)              ok "  последняя известная версия" ;;
    esac
    say ""

    say "${C_BLD}Процедуры${C_OFF}"
    fraim_procedures | while read -r _n; do
        _f=$(fraim_procedure_file "$_n")
        printf '  %-16s %-8s %s\n' "$_n" "$(fm_get "$_f" tier)" "procedures/$_n.md"
    done
    say ""

    say "${C_BLD}Харнесы${C_OFF}"
    _n_found=0
    harness_table | while IFS='	' read -r _key _label _probe _skills _instr; do
        [ -n "$_key" ] || continue
        _skills=$(harness_expand "$_skills")
        if harness_present "$_probe" "$_skills"; then
            _installed=$(grep -rl '^  source: fraim$' "$_skills" 2>/dev/null | wc -l | tr -d ' ')
            _vers=$(grep -rh '^  version: ' "$_skills" 2>/dev/null | sed 's/^  version: //' | sort -u | tr '\n' ' ')
            if [ "$_installed" -gt 0 ]; then
                if [ "$(printf '%s' "$_vers" | tr -d ' ')" = "$_ver" ]; then
                    printf '  %s✓%s %-14s %s скиллов, версия %s\n' "$C_GRN" "$C_OFF" "$_label" "$_installed" "$_ver"
                else
                    printf '  %s!%s %-14s %s скиллов, версии: %s(установлена %s — нужен fraim init)\n' \
                        "$C_YEL" "$C_OFF" "$_label" "$_installed" "$_vers" "$_ver"
                fi
            else
                printf '  %s!%s %-14s найден, скиллы не установлены — запусти fraim init\n' "$C_YEL" "$C_OFF" "$_label"
            fi
        else
            printf '  %s·%s %-14s не найден\n' "$C_DIM" "$C_OFF" "$_label"
        fi
    done
    say ""

    publish_deps_report
    say ""

    say "${C_BLD}Реестр проектов${C_OFF}"
    registry_init
    _total=$(registry_list | wc -l | tr -d ' ')
    if [ "$_total" -eq 0 ]; then
        dim "  пуст"
    else
        say "  проектов: $_total"
        registry_stale | while read -r _p; do
            [ -n "$_p" ] || continue
            warn "  каталог пропал: $_p  ('fraim projects rm' чтобы убрать)"
        done
    fi
}

# --- show -------------------------------------------------------------------
cmd_show() {
    [ $# -ge 1 ] || die "укажи имя процедуры: $(fraim_procedures | tr '\n' ' ')"
    _f=$(fraim_procedure_file "$1") || die "нет такой процедуры: $1"
    cat "$_f"
}

# --- build ------------------------------------------------------------------
# Regenerates the artifacts that live IN the repository (as opposed to on the
# machine): the Claude Code plugin payload and the manifest. Both are generated
# from procedures/ and committed, because a marketplace install clones the repo
# and never runs our CLI.
cmd_build() {
    _root=$(fraim_root) || die "не найден каталог procedures/"
    _build=$(skills_build)

    _plugin="$_root/installer/claude-plugin"
    rm -rf "$_plugin/skills"
    mkdir -p "$_plugin/skills"
    for _s in "$_build"/*/; do
        [ -d "$_s" ] || continue
        _n=$(basename -- "$_s")
        mkdir -p "$_plugin/skills/$_n"
        cp "$_s/SKILL.md" "$_plugin/skills/$_n/SKILL.md"
    done
    ok "плагин Claude Code: $(find "$_plugin/skills" -name SKILL.md | wc -l | tr -d ' ') скиллов"

    manifest_render > "$_root/procedures/manifest.json"
    ok "манифест: procedures/manifest.json"
}


# --- scaffold ---------------------------------------------------------------
cmd_scaffold() {
    _path=${1:-$(pwd -P)}
    _root=$(cd -- "$_path" 2>/dev/null && pwd -P) || die "нет такого каталога: $_path"
    say "Скелет фундамента в $_root"
    say ""
    scaffold_run "$_root" || die "не удалось развернуть скелет"
    registry_init
    registry_add "$_root" >/dev/null 2>&1 && dim "  проект зарегистрирован в реестре"
    say ""
    say "Дальше: ${C_BLD}/bootstrap${C_OFF} для нового проекта, ${C_BLD}/onboard${C_OFF} для существующего кода."
    dim "Файлы помечены маркером fraim:stub — сторож считает их незаполненными, пока он на месте."
    scaffold_copy_notice "$_root"
}

# --- upgrade ----------------------------------------------------------------
# The twin of `scaffold`, for a project laid down by an older release. Same additive
# machinery — nothing existing is ever overwritten — plus the repair of sections the
# system reads by code. Separate name because the situations differ for the human:
# `scaffold` is «завести проект», `upgrade` is «этот уже есть, доведи до стандарта».
cmd_upgrade() {
    _path=${1:-$(pwd -P)}
    _root=$(cd -- "$_path" 2>/dev/null && pwd -P) || die "нет такого каталога: $_path"
    project_is_managed "$_root" || wm_managed "$_root" ||
        die "здесь нечего обновлять: это не проект под системой. Завести — fraim scaffold"
    say "Довожу фундамент до стандарта fraim $(fraim_version) в $_root"
    say ""
    scaffold_run "$_root" || die "не удалось обновить фундамент"
    scaffold_sections "$_root" || die "не удалось дописать разделы"
    if [ "$SCAFFOLD_SECTIONS_ADDED" -gt 0 ]; then
        verb_commit "$_root" upgrade "фундамент доведён до стандарта" CONVENTIONS.md
    fi
    say ""
    ok "готово — проверить: fraim status"
}

# --- version ----------------------------------------------------------------
# Номер версии — плохой ответ на вопрос «приехало ли обновление»: он меняется, только
# когда о нём вспомнили, а между двумя релизами ветка успевает уехать на десяток
# коммитов. Поэтому команда показывает и то, откуда взят исходник: ветку, коммит и его
# дату. Функция fraim_version при этом печатает по-прежнему один номер — он уезжает в
# штампы провенанса и во фронтматтер скиллов, и там ему не место рядом с датой.
cmd_version() {
    _ver=$(fraim_version)
    _root=$(fraim_root 2>/dev/null) || _root=
    if [ -n "$_root" ] && git -C "$_root" rev-parse --git-dir >/dev/null 2>&1; then
        _branch=$(git -C "$_root" rev-parse --abbrev-ref HEAD 2>/dev/null)
        _sha=$(git -C "$_root" rev-parse --short HEAD 2>/dev/null)
        _when=$(git -C "$_root" log -1 --format=%cd --date=short 2>/dev/null)
        printf '%s\n' "$_ver"
        dim "  источник: $_root"
        dim "  ветка $_branch · коммит $_sha · $_when"
    else
        printf '%s\n' "$_ver"
        [ -n "$_root" ] && dim "  источник: $_root (не git-клон)"
    fi
}

# --- publish ----------------------------------------------------------------
# Вывести проект с этой машины. Развилка «какой хост, приватный или публичный» остаётся
# вопросом к человеку — а всё вокруг неё (чем это делать, что при этом уедет, дошло ли)
# перестаёт быть его заботой. Логика — в installer/lib/publish.sh, здесь только разбор
# флагов, ратификация и порядок шагов.
cmd_publish() {
    _prov=; _name=; _url=; _vis=; _yes=0; _check=0; _force=0; _brief=0
    while [ $# -gt 0 ]; do
        case $1 in
            --provider) shift; [ $# -ge 1 ] || die "--provider требует имени"; _prov=$1 ;;
            --provider=*) _prov=${1#--provider=} ;;
            --url) shift; [ $# -ge 1 ] || die "--url требует ссылки"; _url=$1; _prov=url ;;
            --url=*) _url=${1#--url=}; _prov=url ;;
            --name) shift; [ $# -ge 1 ] || die "--name требует имени"; _name=$1 ;;
            --name=*) _name=${1#--name=} ;;
            --private) _vis=private ;;
            --public)  _vis=public ;;
            --yes|-y)  _yes=1 ;;
            --check|--dry-run) _check=1 ;;
            --brief) _brief=1 ;;
            --force)   _force=1 ;;
            -*) die "неизвестный флаг: $1 (см. fraim help)" ;;
            *)  die "лишний аргумент: $1 — имя задаётся через --name" ;;
        esac
        shift
    done
    [ -z "$_prov" ] || publish_provider_known "$_prov" ||
        die "неизвестный провайдер: $_prov (github, gitlab, url)"

    _root=$(pwd -P)
    command -v git >/dev/null 2>&1 || die "git не установлен — отправлять нечем"
    verb_is_git "$_root" ||
        die "здесь нет репозитория — заводится командой fraim scaffold"

    # --brief: то же задание для агента, но по требованию, а не только в отказе. После
    # принятого риска чистку обычно заказывают позже — и тогда её надо чем-то заказать.
    if [ "$_brief" = 1 ]; then
        publish_scan "$_root"
        if [ "$(pub_count "$PUB_STOP")" -eq 0 ]; then
            ok "нечего вычищать: проверка ничего не нашла"
            exit 0
        fi
        publish_brief_secret "$_root"
        exit 0
    fi

    # --check: разведка без сети. Это же режим для агента: он может посмотреть и
    # рассказать, но отправку по-прежнему начинает человек.
    if [ "$_check" = 1 ]; then
        publish_deps_report
        say ""
        if [ -z "$(publish_head "$_root")" ]; then
            warn "нет ни одной точки сохранения — отправлять пока нечего"
            exit 1
        fi
        _have=$(publish_remote_url "$_root")
        if [ -n "$_have" ]; then
            say "Копия: $_have"
            # Всё, что здесь известно, — это память ЭТОЙ машины о прошлых отправках.
            # Разведка идёт без сети (её запускает и агент, и она не должна ни висеть на
            # недоступном хосте, ни ходить наружу без спроса), поэтому граница названа вслух.
            if [ -z "$(git -C "$_root" for-each-ref --count=1 refs/remotes 2>/dev/null)" ]; then
                warn "туда ни разу ничего не уезжало — настройку начали и не довели"
            else
                _n=$(publish_unpushed "$_root")
                if [ "$_n" -gt 0 ]; then
                    say "  не уехало точек: $_n"
                else
                    say "  по записям этой машины — всё уехало"
                fi
            fi
            dim "  что лежит на хосте на самом деле, сверяет fraim publish: для этого нужна сеть"
        else
            say "Копии вне этой машины нет."
        fi
        say ""
        publish_scan "$_root"
        publish_scan_show
        _stops=$(pub_count "$PUB_STOP")
        if [ "$_stops" -gt 0 ]; then
            say ""
            dim "  в приватную копию это отправляется с принятием риска (fraim publish --private),"
            dim "  в публичную — нет; вычистить вместо этого — fraim publish --brief"
            exit 1
        fi
        exit 0
    fi

    [ -n "$(publish_head "$_root")" ] ||
        die "нет ни одной точки сохранения — отправлять пока нечего
    сохрани работу и повтори: fraim clean, либо fraim commit ВИД ТЕКСТ ПУТЬ..."

    # Ремоут есть — значит вопрос «всё ли уехало» решает ХОСТ, а не наши refs/remotes.
    # Ровно здесь ловится незаконченная настройка: репозиторий создали, адрес прописали,
    # а истории там нет. Локальная бухгалтерия в этом случае молчит или врёт.
    _have=$(publish_remote_url "$_root")
    if [ -n "$_have" ]; then
        _branch=$(publish_branch "$_root")
        dim "  спрашиваю хост, что там лежит…"
        publish_host_state "$_root" "$_branch"
        # Хост не принял доступ по этому адресу — чиним транспорт ДО плана. Человек
        # обязан ратифицировать тот адрес, по которому копия действительно поедет, а не
        # тот, по которому ему уже отказали; репозиторий при этом остаётся тем же.
        if [ "$PUB_HOST" = denied ] && publish_transport_https "$_root"; then
            _have=$(publish_remote_url "$_root")
            publish_host_state "$_root" "$_branch"
        fi
        case $PUB_HOST in
            synced)
                ok "копия на месте и совпадает с этой машиной: $_have"
                exit 0 ;;
            diverged)
                publish_refuse_diverged "$_root" "$_have" "$_branch"
                exit 2 ;;
            # empty / behind / unreachable говорит строка «на хосте» в самом плане —
            # одно место, где человек и так читает состояние. Второй раз то же самое
            # сверху — шум, а шум учат пролистывать.
        esac
    fi

    # Развилка. Спрашиваем только там, где ответа у нас нет и быть не может.
    if [ -z "$_have" ]; then
        if [ -z "$_prov" ]; then
            if [ -t 0 ] && [ -t 1 ]; then
                _prov=$(publish_ask_provider) || die "не понял выбор"
            else
                publish_deps_report
                say ""
                die "не сказано, куда публиковать: --provider github|gitlab | --url ССЫЛКА"
            fi
        fi
        if [ "$_prov" = url ] && [ -z "$_url" ]; then
            if [ -t 0 ] && [ -t 1 ]; then
                _url=$(publish_ask_url) || die "без ссылки отправлять некуда"
            else
                die "для --provider url нужна ссылка: --url ССЫЛКА"
            fi
        fi
        if [ "$_prov" != url ] && [ -z "$_vis" ]; then
            if [ -t 0 ] && [ -t 1 ]; then
                _vis=$(publish_ask_visibility)
            else
                # Умолчание одно и оно приватное: публичность не должна получаться
                # молчанием — только явным --public (P0, D3).
                _vis=private
            fi
        fi
    fi
    [ -n "$_vis" ] || _vis=host
    if [ -z "$_name" ]; then
        _name=$(publish_repo_name "$(basename -- "$_root")")
        [ "$_name" = "$(basename -- "$_root")" ] ||
            dim "  имя репозитория «$_name»: хосты принимают только латиницу, цифры, точку, дефис"
    fi

    publish_scan "$_root"
    say ""
    publish_plan_show "$_root" "$_prov" "$_name" "$_url" "$_vis"
    say ""

    # Решает не находка, а то, кто её прочитает. Публичный репозиторий — стоп: принимать
    # такой риск пришлось бы не одному человеку. Приватный — ратификация: находки названы
    # поимённо, «да» отдельное и каждый раз, но стены нет.
    _stops=$(pub_count "$PUB_STOP")
    _accept=0
    if [ "$_stops" -gt 0 ] && [ "$_force" = 0 ]; then
        publish_visibility_effective "$_root" "$_vis" "$_prov"
        if [ "$PUB_VIS" = unknown ] && [ -t 0 ] && [ -t 1 ]; then
            PUB_VIS=$(publish_ask_private)
            PUB_VIS_SRC="с твоих слов"
        fi
        case $PUB_VIS in
            private)
                publish_accept_notice "$_stops"
                _accept=1 ;;
            *)
                # Не совет, а готовое задание: «убери файл из истории» — это просьба об
                # экспертизе, которой у пользователя может не быть, то есть ровно то, что
                # P0 запрещает процедуре предполагать.
                publish_refuse_secret "$_root" "$PUB_VIS"
                exit 2 ;;
        esac
    elif [ "$_stops" -gt 0 ]; then
        warn "--force: находки выше уедут на хост вместе с историей, и это необратимо"
    fi

    if [ "$_yes" = 0 ]; then
        if [ -t 0 ]; then
            if [ "$_accept" = 1 ]; then
                printf '  Публикуем ВМЕСТЕ с находками в приватную копию? [y/N] '
            else
                printf '  Публикуем? [y/N] '
            fi
            read -r _ans || _ans=
            case $_ans in
                y|Y|д|Д|yes|да) ;;
                *)
                    # «Нет» именно на вопросе о находках означает «хочу, но чистым», и
                    # ответ на это — задание агенту, а не одно слово «отменено».
                    if [ "$_stops" -gt 0 ]; then
                        publish_cancel_findings "$_root"
                    else
                        say "  отменено"
                    fi
                    exit 0 ;;
            esac
        else
            dim "  это был только план. Выполнить: fraim publish --yes"
            exit 0
        fi
    fi

    publish_do "$_root" "$_prov" "$_name" "$_url" "$_vis" || exit 1
    exit 0
}

# --- clean ------------------------------------------------------------------
# Один заход вместо тридцати команд. Ратификация не исчезает: план показывается всегда,
# и без «да» ничего не делается — под пайпом «да» это --yes, иначе чистка только покажет.
cmd_clean() {
    _yes=0
    for _a in "$@"; do
        case $_a in
            --yes|-y) _yes=1 ;;
            --dry-run) _yes=0 ;;
            *) die "неизвестный флаг: $_a" ;;
        esac
    done
    _root=$(pwd -P)
    wm_managed "$_root" || die "здесь нечего прибирать: это не проект под системой"
    clean_scan "$_root"
    clean_show || return 0
    say ""
    if [ "$_yes" = 0 ]; then
        if [ -t 0 ]; then
            printf '  Начать? [y/N] '
            read -r _ans || _ans=
            case $_ans in y|Y|д|Д|yes|да) ;; *) say "  отменено"; return 0 ;; esac
        else
            dim "  это был только план. Выполнить: fraim clean --yes"
            return 0
        fi
    fi
    clean_apply "$_root"
}

# --- config -----------------------------------------------------------------
cmd_config() {
    case ${1:-show} in
        show|"")
            _root=$(pwd -P)
            project_is_managed "$_root" || _root=
            say "${C_BLD}Действующие настройки${C_OFF}"
            [ -n "$_root" ] && dim "  проект: $_root" || dim "  вне проекта — показаны машинные и умолчания"
            say ""
            config_table | while IFS='|' read -r _k _def _desc; do
                [ -n "$_k" ] || continue
                _v=$(config_get "$_k" "$_root")
                _s=$(config_source "$_k" "$_root")
                printf '  %s %s %s← %s%s\n' "$(wm_pad "$_k" 22)" "$(wm_pad "$_v" 6)" "$C_DIM" "$_s" "$C_OFF"
                printf '    %s%s%s\n' "$C_DIM" "$_desc" "$C_OFF"
            done
            say ""
            dim "  fraim config set КЛЮЧ ЗНАЧЕНИЕ          — в проект (ai/fraim.conf)"
            dim "  fraim config set --machine КЛЮЧ ЗНАЧЕНИЕ — на машину (~/.fraim/config)"
            ;;
        set)
            shift
            _scope=project
            if [ "${1:-}" = --machine ]; then _scope=machine; shift; fi
            [ $# -ge 2 ] || die "нужно: fraim config set КЛЮЧ ЗНАЧЕНИЕ"
            _k=$1; _v=$2
            config_known "$_k" || die "неизвестный ключ: $_k (список — fraim config)"
            if [ "$_scope" = machine ]; then
                config_set_file "$(config_machine_file)" "$_k" "$_v" || die "не удалось записать"
                ok "$_k = $_v → ~/.fraim/config"
            else
                _root=$(pwd -P)
                project_is_managed "$_root" ||
                    die "здесь нет ai/ — это не проект под системой. Для машинной настройки: --machine"
                config_set_file "$(config_project_file "$_root")" "$_k" "$_v" || die "не удалось записать"
                ok "$_k = $_v → ai/fraim.conf"
            fi
            ;;
        *) die "неизвестная подкоманда: $1" ;;
    esac
}

# --- deterministic verbs ----------------------------------------------------
# Each one replaces a block of prose that used to ask the model to perform a
# mechanical action by hand. See installer/DETERMINISM.md.
verb_root() {
    _root=$(pwd -P)
    [ -d "$_root/ai" ] || die "здесь нет ai/ — это не проект под системой (fraim scaffold)"
    printf '%s\n' "$_root"
}

cmd_task_new()  { [ $# -ge 1 ] || die "нужен слаг задачи"; verb_task_new  "$(verb_root)" "$1"; }
cmd_task_seal() { [ $# -ge 1 ] || die "нужен слаг задачи"; verb_task_seal "$(verb_root)" "$1"; }
cmd_task_block() { [ $# -ge 1 ] || die "нужен слаг задачи"; verb_task_block "$(verb_root)" "$1"; }
cmd_task_result() {
    [ $# -ge 1 ] || die "нужен слаг задачи"
    verb_task_result "$(verb_root)" "$1" "${2:-}"
}
cmd_task_revise() {
    [ $# -ge 3 ] || die "нужно: fraim task-revise СЛАГ \"ДЕФЕКТ\" \"ЧТО ИСПРАВЛЕНО\""
    verb_task_revise "$(verb_root)" "$1" "$2" "$3"
}
cmd_plan_seal() { [ $# -ge 1 ] || die "нужен слаг задачи"; verb_plan_seal "$(verb_root)" "$1"; }

# The body of a decision arrives on stdin, never through argv: a multi-line entry
# squeezed into a command-line argument is how a verb starts shortening content it
# has no business touching. The verb owns placement, heading and date — nothing else.
cmd_decide() {
    [ $# -ge 1 ] || die "нужно: fraim decide \"ЗАГОЛОВОК\" [--supersedes \"ЧТО ЗАМЕНЯЕТ\"] <<'EOF' … EOF"
    _title=$1; shift
    _sup=
    if [ "${1:-}" = --supersedes ]; then
        [ $# -ge 2 ] || die "--supersedes требует текста"
        _sup=$2
    fi
    verb_decide "$(verb_root)" "$_title" "$_sup"
}

cmd_pitfall() { verb_pitfall "$(verb_root)" "$@"; }

cmd_reconcile_seal() { [ $# -ge 1 ] || die "нужен слаг задачи"; verb_reconcile_seal "$(verb_root)" "$1"; }
cmd_investigate_new()  { [ $# -ge 1 ] || die "нужен слаг расследования"; verb_investigate_new  "$(verb_root)" "$1"; }
cmd_investigate_seal() { [ $# -ge 1 ] || die "нужен слаг расследования"; verb_investigate_seal "$(verb_root)" "$1"; }

# The save point, by explicit path list. There is deliberately no way to say "everything":
# `git add .` in a folder the system did not lay down is how secrets and data directories
# get committed, and the person least able to notice that is the one this product is for.
# A verb commits what it touched, and nothing else.
cmd_commit() {
    [ $# -ge 3 ] || die "нужно: fraim commit ВИД ТЕКСТ ПУТЬ... (пути обязательны — «всё» не бывает)"
    _kind=$1; _text=$2
    shift 2
    printf '%s' "$_kind" | grep -qE '^[a-z][a-z-]*$' ||
        die "вид должен быть одним словом в нижнем регистре: task, deploy, onboard, archive…"
    _root=$(pwd -P)
    verb_is_git "$_root" || die "здесь нет git — точку сохранения поставить не во что"
    verb_commit "$_root" "$_kind" "$_text" "$@" || die "коммит не удался"
}
cmd_prune_mark() { verb_prune_mark "$(verb_root)"; }
cmd_stack_passport() { verb_stack_passport "$(pwd -P)"; }
cmd_undo() {
    _root=$(pwd -P)
    if [ $# -ge 1 ]; then verb_undo "$_root" "$1"; else verb_undo_show "$_root"; fi
}
cmd_restore() { verb_restore "$(pwd -P)" "$@"; }

# Dispatch: split a task into parallel subtasks for independent workers.
# Takes an optional plan file; without it, looks for build-plan.md in project.
# The mechanics of a build. Called by the conductor agent — the human types none of these.
# They say what they want and read what came back; every step in between, `accept` (check
# behind the workers, run the project's check, clean up, write the trunk, report) included,
# is the agent's. The human's judgement comes after, in words, and its lever is
# `fraim undo <слияние>` — which the agent runs too.
cmd_dispatch() {
    _sub=${1:-}

    # `check` is the one subcommand that reads a file and writes nothing, so it must
    # work where a plan is written — which is not always inside a project. Without a
    # project the role table simply resolves one level up, from the machine.
    if [ "$_sub" = check ]; then
        [ $# -ge 2 ] || die "нужно: fraim dispatch check ПЛАН"
        _root=$(pwd -P); [ -d "$_root/ai" ] || _root=
        dispatch_check "$2" "$_root" || die "план не годится для параллельной раздачи"
        ok "план проходит dispatch-check"
        say ""
        # What this build costs, before a single worker starts. Warnings first, because a
        # plan that passes the checks can still be a build nobody can accept in one sitting.
        dispatch_size_notes "$2"
        say "$(dispatch_cost_line "$2")"
        say ""
        dispatch_report "$2" "$_root"
        return 0
    fi

    _root=$(verb_root)
    case $_sub in
        verify)
            [ $# -ge 3 ] || die "нужно: fraim dispatch verify СБОРКА ПОДЗАДАЧА [БАЗА]"
            _b=$2; _s=$3
            _plan="$_root/ai/builds/$_b/plan.md"
            [ -f "$_plan" ] || die "нет плана сборки $_b"
            _paths=$(dispatch_field "$_plan" "$_s" 4)
            [ -n "$_paths" ] || die "в сборке $_b нет подзадачи $_s"
            _base=${4:-$(cd "$_root" && git rev-parse HEAD 2>/dev/null)}

            # The worker's own checkout, not the project root — see dispatch_worker_tree.
            # Falling back to the root when there is no checkout keeps the command useful
            # for work done by hand in place, which is how it is used without an ADE.
            _tree=$(dispatch_worker_tree "$_root" "$_b-$_s")
            if [ -n "$_tree" ]; then
                dim "  чекаут подзадачи: $_tree"
            else
                _tree=$_root
                warn "отдельного чекаута $_b-$_s нет — сверяю корень проекта"
            fi
            dispatch_verify_tree "$_tree" "$_base" "$_paths"
            ;;
        run)
            [ $# -ge 2 ] || die "нужно: fraim dispatch run СБОРКА [ВОЛНА]"
            say "Поднимаю флот для сборки $2..."
            if dispatch_launch "$_root" "$2" "${3:-}"; then
                say ""
                ok "флот поднят"
                dim "    состояние:       fraim dispatch watch $2"
                dim "    собрать волну:   fraim dispatch collect $2"
            else
                say ""
                warn "часть воркеров не поднялась — что поднялось, записано в ai/builds/$2/fleet.tsv"
                exit 1
            fi
            ;;
        watch)
            [ $# -ge 2 ] || die "нужно: fraim dispatch watch СБОРКА"
            build_fleet_rows "$_root" "$2" | while IFS='	' read -r _s _t _d _at; do
                if [ -z "$_d" ] || [ "$_d" = "—" ]; then
                    printf '%-12s не поднялась\n' "$_s"; continue
                fi
                _w=$(fleet_worker_show "$_d")
                # Their two words for how a worker is doing. Pulled out rather than
                # printing raw JSON — the first live build showed the operator a wall of
                # it — but the raw answer still shows when neither word is found, because
                # inventing a verdict we did not read would be worse than a wall (§9.5).
                _st=$(printf '%s' "$_w" | tr -d '\n' |
                      grep -oE '"state"[[:space:]]*:[[:space:]]*"[a-z_]*"' | head -1 |
                      sed 's/.*"\([a-z_]*\)"$/\1/')
                _sg=$(printf '%s' "$_w" | tr -d '\n' |
                      grep -oE '"stage"[[:space:]]*:[[:space:]]*"[a-z_]*"' | head -1 |
                      sed 's/.*"\([a-z_]*\)"$/\1/')
                if printf '%s' "$_w" | fleet_ok && [ -n "$_st$_sg" ]; then
                    printf '%-12s %-18s %s %s\n' "$_s" "$_d" "${_st:-—}" "${_sg:+· $_sg}"
                else
                    printf '%-12s %-18s среда ответила не так, как ожидалось:\n' "$_s" "$_d"
                    printf '%s\n' "$_w" | head -4 | sed 's/^/    /'
                fi
            done
            say ""
            dim "    состояние терминала — не статус задачи: завершённая задача может"
            dim "    держать живой терминал. Что сделано — покажет dispatch verify."
            ;;
        collect)
            [ $# -ge 2 ] || die "нужно: fraim dispatch collect СБОРКА [ВОЛНА]"
            if dispatch_collect "$_root" "$2" "${3:-}"; then
                say ""
                ok "волна собрана в ветку $(build_branch "$2")"
                if _next=$(build_next_wave "$_root" "$2"); then
                    dim "    следующая волна:  fraim dispatch run $2"
                    dim "    (волна $_next — воркеры пойдут от собранной ветки)"
                else
                    dim "    все волны собраны — принять работу флота:"
                    dim "    fraim dispatch accept $2  (сверка, мастер-проверка, чистка, отчёт)"
                fi
            else
                say ""
                die "волна собрана не полностью — разберись с отклонёнными и повтори"
            fi
            ;;
        accept)
            # The whole of the acceptance, and all of it the conductor's: check behind every
            # worker, run the project's check on the assembled branch, clean up after the
            # fleet, write the trunk, print the report. The human types nothing — they read
            # this output and answer in words (MODES.md §4, вариант B).
            [ $# -ge 2 ] || die "нужно: fraim dispatch accept СБОРКА"
            _arc=0
            build_accept "$_root" "$2" || _arc=$?
            [ "$_arc" -eq 2 ] && die "приёмка не прошла"
            say ""
            if [ "$_arc" -eq 0 ]; then
                ok "сборка $2 принята, проверена и в стволе"
                dim "    покажи человеку, что выше, и скажи своими словами, чего в цифрах"
                dim "    не видно и в чём ты не уверен — решает он"
            else
                warn "сборка $2 проверена, в ствол не уведена — разберись и повтори"
                exit 1
            fi
            ;;
        list)
            build_list "$_root"
            ;;
        "")
            die "нужно: fraim dispatch ПЛАН (или check / run / watch / collect / verify / accept / list)"
            ;;
        *)
            _plan=$_sub
            [ -f "$_plan" ] || die "плана нет: $_plan"
            dispatch_check "$_plan" "$_root" || die "план не годится для параллельной раздачи"
            dispatch_size_notes "$_plan"

            _bid=build-$(date -u '+%Y%m%d-%H%M%S')
            build_seal "$_root" "$_bid" "$_plan" >/dev/null || die "не удалось завести журнал сборки"

            say "Сборка $_bid — кто что исполняет:"
            say ""
            dispatch_report "$_plan" "$_root"
            say ""

            dispatch_parse_plan "$_plan" | while IFS='|' read -r _id _role _sum _paths; do
                [ -n "$_id" ] || continue
                _d=$(dispatch_write_task "$_root" "$_bid" "$_id" "$_role" "$_sum" "$_paths") ||
                    die "не удалось записать задачу подзадачи $_id"
                dim "  задание $_id → ${_d#"$_root"/}"
            done

            say ""
            ok "задания записаны, журнал заведён: ai/builds/$_bid/journal.md"
            if fleet_present; then
                dim "    поднять волну:   fraim dispatch run $_bid"
                dim "    состояние:       fraim dispatch watch $_bid"
            else
                dim "    среды исполнения на этой машине нет — задания можно исполнить вручную"
            fi
            dim "    собрать волну:     fraim dispatch collect $_bid"
            dim "    сверить с деревом: fraim dispatch verify $_bid ПОДЗАДАЧА"
            ;;
    esac
}

# Interactive assignment. The point is P0: nobody should have to remember that the value
# is three colon-separated fields, nor type a model id from memory. Where a list can be
# had it is offered; where it cannot, a typed value is still accepted — see roles.sh for
# why we do not keep a catalogue of models.
cmd_roles_set() {
    _rs_root=$(pwd -P)
    project_is_managed "$_rs_root" || _rs_root=

    _rs_force_machine=
    if [ "${1:-}" = --machine ]; then _rs_force_machine=1; shift; fi

    # Non-interactive form: `fraim roles set КЛЮЧ ЗНАЧЕНИЕ`. This is the path a Dockerfile
    # or a VM recipe takes — an image is built without a terminal, and baking the role
    # table into the image is the whole point of building one. `fraim config set` cannot
    # do it: it validates the key against config_table, and role_/tier_ keys are open-ended
    # by design, so it refuses every one of them.
    if [ $# -ge 2 ]; then
        _rs_key=$1; _rs_val=$2
        case $_rs_key in
            tier_*|role_*) ;;
            *) _rs_key=role_$_rs_key ;;
        esac
        roles_parse "$_rs_val" >/dev/null ||
            die "«$_rs_val» не в форме агент:модель:усилие"
        if [ -n "$_rs_force_machine" ] || [ -z "$_rs_root" ]; then
            _rs_file=$(config_machine_file)
        else
            _rs_file=$(config_project_file "$_rs_root")
        fi
        config_set_file "$_rs_file" "$_rs_key" "$_rs_val" || die "не удалось записать в $_rs_file"
        ok "$_rs_key = $_rs_val"
        dim "    → $_rs_file"
        return 0
    fi

    menu_supported || die "нужен терминал для выбора — или задай сразу: fraim roles set КЛЮЧ агент:модель:усилие"

    # 1. Which procedure. A tier key is offered too, because setting tier_cheap once is
    #    usually the right move and setting thirteen roles one by one is usually not.
    if [ $# -ge 1 ]; then
        _rs_key=$1
    else
        _rs_key=$({ printf 'tier_cheap\ntier_capable\ntier_strong\n'
                    fraim_procedures 2>/dev/null || :
                  } | roles_pick "Что настраиваем — класс моделей или отдельную процедуру?") ||
            die "отменено"
    fi
    case $_rs_key in
        tier_*) _rs_ckey=$_rs_key ;;
        role_*) _rs_ckey=$_rs_key ;;
        *)      _rs_ckey=role_$_rs_key ;;
    esac

    # 2-4. The three fields. The agent list comes from harness_detect (harness.sh) —
    #      the harnesses fraim knows about and that are present on this machine,
    #      independent of any execution environment. Models offered are the live
    #      catalogue of THIS agent (roles_models_of asks the agent's own channel —
    #      see roles.sh), plus the ones already configured here and the tier
    #      suggestion, so the first run has something to pick even where the agent
    #      cannot be asked.
    _rs_agent=$(roles_agents_available | roles_pick "Агент:" 1) || die "отменено"
    case $_rs_key in
        tier_*) _rs_tier=${_rs_key#tier_} ;;
        *)      _rs_tier=$(roles_tier_of "${_rs_key#role_}" 2>/dev/null || :) ;;
    esac
    _rs_model=$({ roles_models_of "$_rs_agent"; roles_models_seen "$_rs_root"; roles_models_suggested "$_rs_tier"; } |
                grep '[^[:space:]]' | awk '!seen[$0]++' |
                roles_pick "Модель:" 1) || die "отменено"
    _rs_effort=$(roles_efforts_of "$_rs_agent" "$_rs_model" | roles_pick "Усилие:" 2) || die "отменено"

    _rs_val="$_rs_agent:$_rs_model:$_rs_effort"
    roles_parse "$_rs_val" >/dev/null || die "получилось «$_rs_val» — это не агент:модель:усилие"

    # 5. Which level. Project beats machine (§11.3, C), so the question is real whenever
    #    we are standing inside a project.
    _rs_file=$(config_machine_file)
    if [ -n "$_rs_root" ]; then
        _rs_lvl=$(printf 'эта машина (~/.fraim/config)\nтолько этот проект (ai/fraim.conf)\n' |
                  roles_pick "Где записать?" 1) || die "отменено"
        case $_rs_lvl in
            *fraim.conf*) _rs_file=$(config_project_file "$_rs_root") ;;
        esac
    fi

    config_set_file "$_rs_file" "$_rs_ckey" "$_rs_val" || die "не удалось записать в $_rs_file"
    say ""
    ok "$_rs_ckey = $_rs_val"
    dim "    → $_rs_file"
}

# The mode of this project: which of the two defined modes is in force here.
#
# Not a preset of behaviours — MODES.md §1 is explicit that a mode answers "who has the
# right to do what", and the authority inside each mode lives in the foundation and is not
# configurable. What this switches is which mode is active, and the visible effect is the
# context block in AGENTS.md: that is where an agent entering the project learns whether it
# is a conductor. So there is no command to "start conducting" — being in the mode is the
# whole mechanism.
cmd_mode() {
    _md_root=$(verb_root)
    _md_cur=$(mode_get "$_md_root")

    # Called by the harness at session start, not by a human: prints the mode's briefing
    # as JSON for `additionalContext`. Silent and successful in reactive mode, so the hook
    # can stay installed harmlessly if someone leaves it behind.
    if [ "${1:-}" = --hook ]; then
        context_hook_payload "$_md_root" || :
        return 0
    fi

    if [ $# -eq 0 ]; then
        say "режим: ${C_BLD}$_md_cur${C_OFF} · $(config_source mode "$_md_root")"
        say ""
        case $_md_cur in
            fleet)
                dim "    агент, входящий в проект, работает дирижёром: планирует, раздаёт"
                dim "    флоту и сверяет, но приёмка — твоя (B5)"
                dim "    вернуть реактивный режим: fraim mode reactive" ;;
            *)
                dim "    агент делает работу сам, в этом разговоре: точка сохранения,"
                dim "    строка в DECISIONS.md, сторож на входе — задачи он себе не заводит"
                dim "    включить дирижёра и флот: fraim mode fleet" ;;
        esac
        return 0
    fi

    # Старые имена принимаются, но не пишутся: `task` был реактивным режимом под другим
    # именем, `parallel` — флотом. Они лежат в ai/fraim.conf у всех проектов, заведённых
    # до переименования, и молча ронять их режим нельзя.
    case $1 in
        reactive|fleet) _md_new=$1 ;;
        task)     _md_new=reactive; warn "«task» — старое имя реактивного режима, пишу reactive" ;;
        parallel) _md_new=fleet;    warn "«parallel» — старое имя режима флота, пишу fleet" ;;
        *) die "режим бывает reactive или fleet, а не «$1»" ;;
    esac

    if [ "$_md_new" = fleet ] && ! fleet_present; then
        warn "среды исполнения на этой машине нет — флот поднять будет нечем"
        dim "    планирование и проверки работают, а «fraim dispatch run» откажет"
    fi

    config_set_file "$(config_project_file "$_md_root")" mode "$_md_new" ||
        die "не удалось записать режим"

    CTX_ROOT=$_md_root
    context_install "$_md_root/AGENTS.md" context_project_block ||
        die "режим записан, но AGENTS.md обновить не удалось — агент его не увидит"

    ok "режим: $_md_new"

    # The hook is what actually STARTS the mode: AGENTS.md is a file the agent may read,
    # a SessionStart hook is text the harness puts into its context before the first turn.
    case $_md_new in fleet) _md_hook=on ;; *) _md_hook=off ;; esac
    if context_hook_set "$_md_root" "$_md_hook"; then
        case $_md_new in
            fleet) dim "    хук SessionStart поставлен — дирижёрская инструкция придёт" ;;
            *)     dim "    хук SessionStart снят" ;;
        esac
        dim "    в контекст агента на старте сессии, без единого нажатия"
    else
        _md_rc=$?
        if [ "$_md_rc" -eq 2 ]; then
            warn "нет python3 — хук SessionStart не поставлен"
            dim "    режим держится только на AGENTS.md, а это агент может и пролистать"
        else
            warn ".claude/settings.json не удалось обновить — хук не поставлен"
        fi
    fi
    dim "    AGENTS.md обновлён"
}

# The role table (MODES.md §11.3): what a role resolves to here, and from which level.
cmd_roles() {
    if [ "${1:-}" = set ]; then shift; cmd_roles_set "$@"; return; fi
    _root=$(pwd -P)
    project_is_managed "$_root" || _root=
    _rs=$(roles_list "$_root")
    if [ -z "$_rs" ]; then
        say "ролей не задано — всё пойдёт на встроенный дефолт:"
        printf '  %s\n' "$(roles_resolve default "$_root" | tr '\t' ' ')"
        say ""
        dim "    задать: fraim config set role_refactor claude:haiku:medium"
        return 0
    fi
    # Literal, not a printf format: POSIX printf pads to BYTES, and these headings are
    # Cyrillic — %-15s on «роль» pads 8 bytes to 15 and lands 4 characters wide.
    printf 'роль            агент   модель   усилие  источник\n'
    for _r in $_rs; do
        _ex=$(roles_resolve "$_r" "$_root") || continue
        _ra=$(printf '%s' "$_ex" | cut -f1)
        _rnote=$(fleet_caps_describe "$_ra" 2>/dev/null || :)
        printf '%-15s %-7s %-8s %-7s %s%s\n' "$_r" \
            "$_ra" \
            "$(printf '%s' "$_ex" | cut -f2)" \
            "$(printf '%s' "$_ex" | cut -f3)" \
            "$(roles_source "$_r" "$_root")" \
            "${_rnote:+  ← $_rnote}"
    done
}

# --- dispatch ---------------------------------------------------------------
# A bare `fraim` is the most common thing typed by someone who does not know
# what to type — answering it with a list of twenty commands is the worst
# available reply. On a terminal it opens the menu; through a pipe (an agent,
# cron, CI) it prints the usage exactly as before.
[ $# -ge 1 ] || { menu_run; exit 0; }
_cmd=$1; shift
case $_cmd in
    menu)          menu_run ;;
    init)          cmd_init "$@" ;;
    update)        cmd_update "$@" ;;
    scaffold)      cmd_scaffold "$@" ;;
    upgrade)       cmd_upgrade "$@" ;;
    clean)         cmd_clean "$@" ;;
    publish)       cmd_publish "$@" ;;
    config)        cmd_config "$@" ;;
    task-new)      cmd_task_new "$@" ;;
    task-block)    cmd_task_block "$@" ;;
    task-result)   cmd_task_result "$@" ;;
    task-revise)   cmd_task_revise "$@" ;;
    task-seal)     cmd_task_seal "$@" ;;
    plan-seal)     cmd_plan_seal "$@" ;;
    decide)        cmd_decide "$@" ;;
    pitfall)       cmd_pitfall "$@" ;;
    reconcile-seal) cmd_reconcile_seal "$@" ;;
    investigate-new)  cmd_investigate_new "$@" ;;
    investigate-seal) cmd_investigate_seal "$@" ;;
    commit)        cmd_commit "$@" ;;
    undo)          cmd_undo "$@" ;;
    restore)       cmd_restore "$@" ;;
    prune-mark)    cmd_prune_mark "$@" ;;
    stack-passport) cmd_stack_passport "$@" ;;
    status)        cmd_status "$@" ;;
    fleet)         cmd_fleet "$@" ;;
    dispatch)      cmd_dispatch "$@" ;;
    roles)         cmd_roles "$@" ;;
    mode)          cmd_mode "$@" ;;
    projects)      cmd_projects "$@" ;;
    doctor)        cmd_doctor "$@" ;;
    show)          cmd_show "$@" ;;
    build)         cmd_build "$@" ;;
    version|--version|-v) cmd_version ;;
    help|--help|-h) usage ;;
    *) printf 'fraim: неизвестная команда: %s\n\n' "$_cmd" >&2; usage >&2; exit 2 ;;
esac
