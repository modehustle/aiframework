#!/bin/sh
# fraim — the operational layer for agent-driven projects.
#
# Owns state and lifecycle: what is installed where, which projects exist,
# how much drift each has accumulated. It does NOT serve procedure text —
# the agent reads that from the skill files on disk, because a 20 KB
# procedure through stdout gets truncated by some harnesses, and because in
# CI or a web session the CLI may not be installed while the file still is.

set -eu

_self=$0
# install.sh always installs fraim as a symlink into ~/.local/bin, so $0 is
# the link, not the file — resolve the chain before deriving lib/ from it,
# or every installed command breaks with "no such file".
while [ -L "$_self" ]; do
    _link=$(readlink -- "$_self")
    case $_link in
        /*) _self=$_link ;;
        *)  _self=$(dirname -- "$_self")/$_link ;;
    esac
done
_libdir=$(cd -- "$(dirname -- "$_self")/../lib" 2>/dev/null && pwd -P) || {
    # No lib/ means no catalogs either, so this one line is in the fallback language.
    printf 'fraim: lib/ directory not found next to the executable\n' >&2
    exit 2
}

# The operator's message catalogs sit next to lib/. Set before core.sh, which loads them.
FRAIM_LOCALE_DIR=${FRAIM_LOCALE_DIR:-$(cd -- "$_libdir/../locale" 2>/dev/null && pwd -P)}
# shellcheck source=../lib/core.sh
. "$_libdir/core.sh"
. "$_libdir/skills.sh"
. "$_libdir/harness.sh"
. "$_libdir/ade.sh"
. "$_libdir/registry.sh"
. "$_libdir/context.sh"
. "$_libdir/config.sh"
. "$_libdir/scaffold.sh"
. "$_libdir/lang.sh"
. "$_libdir/verbs.sh"
. "$_libdir/tasks.sh"
. "$_libdir/foundation.sh"
. "$_libdir/verbtable.sh"
. "$_libdir/watchman.sh"
. "$_libdir/clean.sh"
. "$_libdir/publish.sh"
. "$_libdir/update.sh"
. "$_libdir/roles.sh"
. "$_libdir/fleet.sh"
. "$_libdir/dispatch.sh"
. "$_libdir/menu.sh"

usage() {
    printf '%s\n' "$(t cli_usage_head)"
    vt_help
    printf '%s\n' "$(t cli_usage_tail)"
}

# --- init -------------------------------------------------------------------
cmd_init() {
    _root=$(fraim_root) || die "$(t cli_init_err_broken)"
    _ver=$(fraim_version)
    say "$(t cli_init_source ver="$_ver" root="$_root")"
    say ""

    _build=$(skills_build)
    _n=$(find "$_build" -name SKILL.md | wc -l | tr -d ' ')
    ok "$(t cli_init_skills_built n="$_n")"

    registry_init

    harness_detect | while IFS='	' read -r _key _label _skills _instr; do
        [ -n "$_key" ] || continue
        _count=$(harness_install "$_label" "$_skills" "$_build") || {
            warn "$(t cli_init_harness_failed label="$_label")"
            continue
        }
        ok "$_label → $_skills ($_count)"
        if [ -n "$_instr" ]; then
            if context_install "$_instr"; then
                dim "    $(t cli_context_block path="$_instr")"
            else
                warn "$(t cli_init_context_failed label="$_label" path="$_instr")"
            fi
        fi
    done
    _found=$(harness_detect | wc -l | tr -d ' ')

    if [ "$_found" -eq 0 ]; then
        say ""
        warn "$(t cli_init_no_harness)"
        dim "    $(t cli_init_no_harness_copy path="$_build")"
        dim "    $(t cli_init_no_harness_rerun)"
    fi

    # Register the current project if it is under the system. bootstrap and
    # onboard both end here too, so the registry fills itself as projects
    # come under the system rather than by hand.
    _cwd=$(pwd -P)
    if project_is_managed "$_cwd"; then
        registry_add "$_cwd" && ok "$(t cli_registered path="$_cwd")"
        # The PROJECT block, not the machine one. They share the marker pair, so writing
        # the machine block here would have overwritten what `fraim scaffold` puts in a
        # project's AGENTS.md — and it would be the wrong text anyway: a routing table for
        # skills installed on this machine says nothing to the agent that clones the repo.
        if context_install "$_cwd/AGENTS.md" context_project_block; then
            dim "    $(t cli_context_block path="$_cwd/AGENTS.md")"
        fi
    fi

    claude_permission_hint

    # Init lays out the machine; the projects follow with one command of their own, because
    # bringing them up commits into each of them — that is the human's call, not a side
    # effect of an update.
    _n_proj=$(registry_list | wc -l | tr -d ' ')
    if [ "$_n_proj" -gt 0 ]; then
        dim "  $(t cli_init_registry_count n="$_n_proj")"
    fi

    # The only place in init that touches the network, and it is optional: find out whether
    # something newer has already shipped. Silently and no more than once per
    # update_check_days; a network refusal breaks nothing. The watchman later reads the ready
    # answer from the cache without going anywhere itself.
    update_probe_if_due
    if [ "$(update_state)" = behind ]; then
        say ""
        warn "$(update_line)"
    fi

    say ""
    say "$(t cli_init_done cmd="${C_BLD}fraim doctor${C_OFF}")"
}

# --- update -----------------------------------------------------------------
# `fraim init` lays out what is already on disk. `fraim update` first brings in what is
# new, then lays it out — and these are two different commands, because init is also
# needed on its own: installed a new harness → init, the network has nothing to do with it.
#
# --check changes nothing and fits a schedule: exit 1 if we are behind.
cmd_update() {
    case ${1:-} in
        --check)
            if ! update_src_is_clone; then
                warn "$(t cli_upd_not_clone)"
                return 0
            fi
            update_probe || :
            case $(update_state) in
                behind)  warn "$(update_line)"; return 1 ;;
                ahead)   ok "$(update_line)"; return 0 ;;
                unknown) warn "$(update_line)"
                         dim "    $(t cli_upd_network_hint)"
                         return 1 ;;
                *)       ok "$(t cli_upd_latest ver="$(fraim_version)")"; return 0 ;;
            esac ;;
        --quiet)
            # For an image or a VM recipe: run at every start, say nothing when there is
            # nothing to say, and NEVER stand between the human and their session.
            #
            # Every failure path here exits 0 on purpose. A dead network, a private repo
            # without credentials, a source that is not a clone — none of those are reasons
            # to stop an agent from starting. Working on a version one commit old beats not
            # working at all, and the person finds out from `fraim version` either way.
            update_src_is_clone || exit 0
            update_probe >/dev/null 2>&1 || exit 0
            [ "$(update_state)" = behind ] || exit 0
            _u_before=$(fraim_version)
            if update_apply >/dev/null 2>&1; then
                ok "$(t cli_upd_updated from="$_u_before" to="$(fraim_version)")"
                exec "$(update_src)/installer/bin/fraim" init >/dev/null 2>&1
            fi
            exit 0
            ;;
        "") ;;
        *)  die "$(t cli_upd_err_flag flag="$1")" ;;
    esac

    say "$(t cli_upd_title)"
    say ""
    _u_before=$(fraim_version)
    update_apply || return 1
    say ""
    # New binary, new lib/, new procedures — and only now the layout.
    # This process cannot continue: it read lib/ before the update.
    _u_bin="$(update_src)/installer/bin/fraim"
    dim "  $(t cli_upd_was ver="$_u_before")"
    exec "$_u_bin" init
}

# Claude Code gates shell calls, so without a standing permission the control
# panel hits an approval prompt on every status check. We only touch settings
# when a JSON-safe editor is available; otherwise we print the line and let
# the human add it, per the system's own rule about host-level config.
claude_permission_hint() {
    _settings="$HOME/.claude/settings.json"
    [ -d "$HOME/.claude" ] || return 0
    if command -v python3 >/dev/null 2>&1; then
        # Exit 0: the rule was there already; 10: added now (the words are ours, below);
        # anything else: the file could not be edited, so the human gets the line to add.
        _cph_rc=0
        python3 - "$_settings" <<'PY' || _cph_rc=$?
import json, os, sys
path = sys.argv[1]
try:
    with open(path) as f:
        data = json.load(f)
except FileNotFoundError:
    data = {}
except (json.JSONDecodeError, OSError):
    sys.exit(1)
if not isinstance(data, dict):
    sys.exit(1)
perms = data.setdefault("permissions", {})
allow = perms.setdefault("allow", [])
rule = "Bash(fraim:*)"
if rule in allow:
    sys.exit(0)
allow.append(rule)
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".fraim.tmp"
with open(tmp, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
sys.exit(10)
PY
        case $_cph_rc in
            0)  return 0 ;;
            10) say "  $(t cli_perm_added)"; return 0 ;;
        esac
    fi
    dim "    $(t cli_perm_hint)"
    return 0
}

# --- status -----------------------------------------------------------------
cmd_status() {
    _json=0; _path=
    for _a in "$@"; do
        case $_a in
            --json) _json=1 ;;
            -*) die "$(t cli_err_unknown_flag flag="$_a")" ;;
            *) _path=$_a ;;
        esac
    done
    [ -n "$_path" ] || _path=$(pwd -P)
    _root=$(cd -- "$_path" 2>/dev/null && pwd -P) || die "$(t cli_err_no_dir path="$_path")"

    if ! wm_managed "$_root"; then
        if [ "$_json" = 1 ]; then
            printf '{ "project": "%s", "status": "unmanaged", "findings": [] }\n' "$_root"
        else
            warn "$(t cli_status_unmanaged path="$_root")"
            dim "    $(t cli_status_unmanaged_hint)"
        fi
        exit 2
    fi

    wm_run "$_root"
    if [ "$_json" = 1 ]; then wm_report_json "$_root"; else wm_report_human "$_root"; fi
    if wm_has_attention; then exit 1; fi
    exit 0
}

# --- fleet ------------------------------------------------------------------
# Read-only, like `status`: where the work of this project actually lives.
#
# The register of checkouts is git, not the ADE, so this answers even with no fleet
# runtime installed — and that is the common case today. The environment section only
# adds what git cannot know: whether a runtime is answering, and whether something is
# scheduled against this project.

# Open tasks in one checkout: cards on its board (tasks.sh).
fleet_counts() {
    tasks_scan "$1" | grep -c . || true
}

fleet_state_words() {
    if [ "$1" -gt 0 ]; then printf '%s\n' "$(tp "$1" cli_fleet_on_board)"
    else printf '%s\n' "$(t cli_fleet_clean)"; fi
}

cmd_fleet() {
    _json=0; _path=
    for _a in "$@"; do
        case $_a in
            --json) _json=1 ;;
            -*) die "$(t cli_err_unknown_flag flag="$_a")" ;;
            *) _path=$_a ;;
        esac
    done
    [ -n "$_path" ] || _path=$(pwd -P)
    _root=$(cd -- "$_path" 2>/dev/null && pwd -P) || die "$(t cli_err_no_dir path="$_path")"
    verb_is_git "$_root" || die "$(t cli_fleet_err_not_repo path="$_root")"

    _list=$(git -C "$_root" worktree list --porcelain 2>/dev/null) || _list=

    [ "$_json" = 1 ] || printf '%s%s%s\n' "$C_BLD" "$(basename -- "$_root")" "$C_OFF"
    [ "$_json" = 1 ] && printf '{\n  "project": "%s",\n  "checkouts": [' "$_root"

    _old_ifs=$IFS
    set -f
    IFS='
'
    _first=1
    for _p in $(printf '%s\n' "$_list" | sed -n 's/^worktree //p'); do
        [ -d "$_p" ] || continue
        _real=$(cd -- "$_p" 2>/dev/null && pwd -P) || continue
        set +f                      # fleet_counts globs; `set -f` above would mute it
        _open=$(fleet_counts "$_real")
        set -f
        _here=false; [ "$_real" = "$_root" ] && _here=true
        if [ "$_json" = 1 ]; then
            [ "$_first" = 1 ] || printf ','
            _first=0
            printf '\n    { "path": "%s", "current": %s, "open_tasks": %s }' \
                "$(wm_json_escape "$_real")" "$_here" "$_open"
        else
            _mark='  '; [ "$_here" = true ] && _mark=' ▸'
            printf '%s %s  %s%s%s\n' "$_mark" "$(wm_pad "$_real" 48)" \
                "$C_DIM" "$(fleet_state_words "$_open")" "$C_OFF"
        fi
    done
    IFS=$_old_ifs
    set +f

    [ "$_json" = 1 ] && printf '\n  ],\n  "ade": ['

    # The environment, when there is one. Absence is silence: an ADE is the operator's
    # choice, and a project without one is not a project with a problem (C1).
    _det=$(ade_detect)
    _old_ifs=$IFS
    IFS='
'
    _first=1
    for _row in $_det; do
        _label=$(printf '%s' "$_row" | cut -f2)
        _key=$(printf '%s' "$_row" | cut -f1)
        _cmd=$(printf '%s' "$_row" | cut -f3)
        if ade_alive "$_cmd"; then _alive=true; else _alive=false; fi
        _auto=none
        if [ "$_alive" = true ]; then
            _a=$(ade_automations "$_cmd" "$_root")
            if [ "$(printf '%s' "$_a" | cut -f1)" = 1 ]; then
                if [ "$(printf '%s' "$_a" | cut -f2)" = 1 ]; then _auto=watchman; else _auto=free; fi
            fi
        fi
        if [ "$_json" = 1 ]; then
            [ "$_first" = 1 ] || printf ','
            _first=0
            printf '\n    { "key": "%s", "command": "%s", "alive": %s, "automations": "%s" }' \
                "$_key" "$(wm_json_escape "$_cmd")" "$_alive" "$_auto"
        else
            if [ "$_alive" = true ]; then
                ok "$(t cli_fleet_ade_alive label="$_label" cmd="$_cmd")"
            else
                dim "  $(t cli_fleet_ade_silent label="$_label" cmd="$_cmd")"
            fi
            case $_auto in
                free) warn "$(t cli_fleet_auto_free label="$_label")" ;;
                watchman) dim "  $(t cli_fleet_auto_watchman label="$_label")" ;;
            esac
        fi
    done
    IFS=$_old_ifs

    if [ "$_json" = 1 ]; then
        printf '\n  ]\n}\n'
    elif [ -z "$_det" ]; then
        dim "  $(t cli_fleet_no_ade)"
    fi
    exit 0
}

# --- projects ---------------------------------------------------------------
cmd_projects() {
    registry_init
    case ${1:-list} in
        list|"")
            _any=0
            registry_list | while read -r _p; do
                [ -n "$_p" ] || continue
                if [ -d "$_p" ]; then say "  $_p"; else printf '  %s%s  %s%s\n' "$C_DIM" "$_p" "$(t cli_proj_no_dir)" "$C_OFF"; fi
            done
            _any=$(registry_list | wc -l | tr -d ' ')
            if [ "$_any" -eq 0 ]; then
                dim "  $(t cli_proj_empty)"
            fi
            ;;
        add) [ $# -ge 2 ] || die "$(t cli_err_need_path)"; registry_add "$2" && ok "$(t cli_proj_added path="$2")" ;;
        rm)  [ $# -ge 2 ] || die "$(t cli_err_need_path)"; registry_rm "$2" && ok "$(t cli_proj_removed path="$2")" ;;
        *)   die "$(t cli_err_subcommand sub="$1")" ;;
    esac
}

# --- doctor -----------------------------------------------------------------
cmd_doctor() {
    _ver=$(fraim_version)
    _root=$(fraim_root) || die "$(t cli_err_no_procedures)"
    say "${C_BLD}fraim $_ver${C_OFF}"
    if git -C "$_root" rev-parse --git-dir >/dev/null 2>&1; then
        say "  $(t cli_doc_source_git root="$_root" branch="$(git -C "$_root" rev-parse --abbrev-ref HEAD 2>/dev/null)" sha="$(git -C "$_root" rev-parse --short HEAD 2>/dev/null)" date="$(git -C "$_root" log -1 --format=%cd --date=short 2>/dev/null)")"
    else
        say "  $(t cli_doc_source root="$_root")"
    fi
    say "  $(t cli_doc_state path="$FRAIM_HOME")"
    # The only network in doctor, and it belongs: doctor is called precisely to find out
    # whether everything is in place, and "has something newer shipped" is part of that.
    update_probe_if_due
    case $(update_state) in
        behind|unknown) warn "  $(update_line)" ;;
        ahead)          dim "  $(update_line)" ;;
        *)              ok "  $(t cli_doc_latest)" ;;
    esac
    say ""

    say "${C_BLD}$(t cli_doc_procedures)${C_OFF}"
    fraim_procedures | while read -r _n; do
        _f=$(fraim_procedure_file "$_n")
        printf '  %-16s %-8s %s\n' "$_n" "$(fm_get "$_f" tier)" "procedures/$_n.md"
    done
    say ""

    say "${C_BLD}$(t cli_doc_harnesses)${C_OFF}"
    _n_found=0
    harness_table | while IFS='	' read -r _key _label _probe _skills _instr; do
        [ -n "$_key" ] || continue
        _skills=$(harness_expand "$_skills")
        if harness_present "$_probe" "$_skills"; then
            _installed=$(grep -rl '^  source: fraim$' "$_skills" 2>/dev/null | wc -l | tr -d ' ')
            _vers=$(grep -rh '^  version: ' "$_skills" 2>/dev/null | sed 's/^  version: //' | sort -u | tr '\n' ' ')
            if [ "$_installed" -gt 0 ]; then
                if [ "$(printf '%s' "$_vers" | tr -d ' ')" = "$_ver" ]; then
                    printf '  %s✓%s %-14s %s\n' "$C_GRN" "$C_OFF" "$_label" "$(t cli_doc_skills_ok n="$_installed" ver="$_ver")"
                else
                    printf '  %s!%s %-14s %s\n' "$C_YEL" "$C_OFF" "$_label" \
                        "$(t cli_doc_skills_mismatch n="$_installed" vers="$_vers" ver="$_ver")"
                fi
            else
                printf '  %s!%s %-14s %s\n' "$C_YEL" "$C_OFF" "$_label" "$(t cli_doc_no_skills)"
            fi
        else
            printf '  %s·%s %-14s %s\n' "$C_DIM" "$C_OFF" "$_label" "$(t cli_doc_not_found)"
        fi
    done
    say ""

    publish_deps_report
    say ""

    say "${C_BLD}$(t cli_doc_registry)${C_OFF}"
    registry_init
    _total=$(registry_list | wc -l | tr -d ' ')
    if [ "$_total" -eq 0 ]; then
        dim "  $(t cli_doc_registry_empty)"
    else
        say "  $(t cli_doc_registry_count n="$_total")"
        registry_stale | while read -r _p; do
            [ -n "$_p" ] || continue
            warn "  $(t cli_doc_registry_gone path="$_p")"
        done
    fi
}

# --- show -------------------------------------------------------------------
cmd_show() {
    [ $# -ge 1 ] || die "$(t cli_show_err_need_name list="$(fraim_procedures | tr '\n' ' ')")"
    _f=$(fraim_procedure_file "$1") || die "$(t cli_show_err_unknown name="$1")"
    cat "$_f"
}

# --- build ------------------------------------------------------------------
# Regenerates the artifacts that live IN the repository (as opposed to on the
# machine): the Claude Code plugin payload and the manifest. Both are generated
# from procedures/ and committed, because a marketplace install clones the repo
# and never runs our CLI.
cmd_build() {
    _root=$(fraim_root) || die "$(t cli_err_no_procedures)"
    _build=$(skills_build)

    _plugin="$_root/installer/claude-plugin"
    rm -rf "$_plugin/skills"
    mkdir -p "$_plugin/skills"
    for _s in "$_build"/*/; do
        [ -d "$_s" ] || continue
        _n=$(basename -- "$_s")
        mkdir -p "$_plugin/skills/$_n"
        cp "$_s/SKILL.md" "$_plugin/skills/$_n/SKILL.md"
    done
    ok "$(t cli_build_plugin n="$(find "$_plugin/skills" -name SKILL.md | wc -l | tr -d ' ')")"

    manifest_render > "$_root/procedures/manifest.json"
    ok "$(t cli_build_manifest)"
}


# --- scaffold ---------------------------------------------------------------
cmd_scaffold() {
    _path=${1:-$(pwd -P)}
    _root=$(cd -- "$_path" 2>/dev/null && pwd -P) || die "$(t cli_err_no_dir path="$_path")"
    say "$(t cli_scaf_title path="$_root")"
    say ""
    scaffold_run "$_root" || die "$(t cli_scaf_err)"
    registry_init
    registry_add "$_root" >/dev/null 2>&1 && dim "  $(t cli_scaf_registered)"
    say ""
    say "$(t cli_scaf_next bootstrap="${C_BLD}/bootstrap${C_OFF}" onboard="${C_BLD}/onboard${C_OFF}")"
    dim "$(t cli_scaf_stub_note)"
    scaffold_copy_notice "$_root"
}

# --- upgrade ----------------------------------------------------------------
# The twin of `scaffold`, for a project laid down by an older release. Same additive
# machinery — nothing existing is ever overwritten — plus the repair of sections the
# system reads by code. Separate name because the situations differ for the human:
# `scaffold` is "start a project", `upgrade` is "this one exists, bring it up to standard".
#
# A new release reaches the machine once (`fraim update`), and every project on it then lags
# behind until somebody walks into each one. So with no path `upgrade` is a machine command:
# every project in the registry, plus the one the human stands in if it is under the system
# and not registered yet (it is registered on the way — that is how the watchman's «fraim
# upgrade» keeps working from inside an unregistered project). With a path it is that one
# project only.
cmd_upgrade() {
    if [ $# -gt 0 ]; then upgrade_project "$1"; return; fi
    registry_init
    _cwd=$(pwd -P)
    if project_is_managed "$_cwd" && ! registry_list | grep -qxF "$_cwd"; then
        registry_add "$_cwd" && dim "  $(t cli_registered path="$_cwd")"
    fi
    _all=$(registry_list)
    [ -n "$_all" ] || die "$(t cli_upg_err_empty)"
    _ok=0; _skip=0; _fail=0
    # Each project in its own subshell: a refusal (die) in one must not end the sweep,
    # and a path with spaces must survive — hence a line at a time, not a word list.
    _old_ifs=$IFS
    IFS='
'
    for _p in $_all; do
        IFS=$_old_ifs
        say ""
        say "${C_BLD}== $_p${C_OFF}"
        if [ ! -d "$_p" ]; then
            warn "$(t cli_upg_skip_no_dir path="$_p")"
            _skip=$((_skip + 1)); continue
        fi
        if ! project_is_managed "$_p" && ! wm_managed "$_p"; then
            warn "$(t cli_upg_skip_unmanaged)"
            _skip=$((_skip + 1)); continue
        fi
        if ( upgrade_project "$_p" ); then _ok=$((_ok + 1)); else _fail=$((_fail + 1)); fi
    done
    IFS=$_old_ifs
    say ""
    say "$(t cli_upg_summary ok="$_ok" skip="$_skip" fail="$_fail")"
    [ "$_fail" -eq 0 ] || return 1
}

upgrade_project() {
    _path=$1
    _root=$(cd -- "$_path" 2>/dev/null && pwd -P) || die "$(t cli_err_no_dir path="$_path")"
    project_is_managed "$_root" || wm_managed "$_root" ||
        die "$(t cli_upg_err_unmanaged)"
    say "$(t cli_upg_title ver="$(fraim_version)" path="$_root")"
    say ""
    scaffold_run "$_root" || die "$(t cli_upg_err_scaffold)"
    scaffold_sections "$_root" || die "$(t cli_upg_err_sections)"
    if [ "$SCAFFOLD_SECTIONS_ADDED" -gt 0 ]; then
        verb_commit "$_root" upgrade "foundation brought up to the standard" CONVENTIONS.md
    fi
    tasks_upgrade "$_root" || die "$(t cli_upg_err_tasks)"
    if [ "$(config_conf_refresh "$_root")" = changed ]; then
        ok "$(t cli_upg_conf_refreshed)"
        verb_commit "$_root" upgrade "settings list brought up to date" ai/fraim.conf
    fi
    say ""
    ok "$(t cli_upg_done)"
}

# --- version ----------------------------------------------------------------
# A version number is a poor answer to "did the update arrive": it changes only when
# somebody remembers to bump it, while between two releases the branch can move a dozen
# commits. So the command also shows where the source came from: branch, commit and its
# date. fraim_version itself still prints a single number — it goes into provenance stamps
# and skill frontmatter, and a date has no place next to it there.
cmd_version() {
    _ver=$(fraim_version)
    _root=$(fraim_root 2>/dev/null) || _root=
    if [ -n "$_root" ] && git -C "$_root" rev-parse --git-dir >/dev/null 2>&1; then
        _branch=$(git -C "$_root" rev-parse --abbrev-ref HEAD 2>/dev/null)
        _sha=$(git -C "$_root" rev-parse --short HEAD 2>/dev/null)
        _when=$(git -C "$_root" log -1 --format=%cd --date=short 2>/dev/null)
        printf '%s\n' "$_ver"
        dim "  $(t cli_ver_source root="$_root")"
        dim "  $(t cli_ver_git branch="$_branch" sha="$_sha" date="$_when")"
    else
        printf '%s\n' "$_ver"
        [ -n "$_root" ] && dim "  $(t cli_ver_not_clone root="$_root")"
    fi
}

# --- publish ----------------------------------------------------------------
# Get the project off this machine. The fork "which host, private or public" stays a
# question for the human — and everything around it (what to do it with, what will leave,
# whether it arrived) stops being their concern. The logic is in installer/lib/publish.sh;
# here only flag parsing, ratification and the order of steps.
cmd_publish() {
    _prov=; _name=; _url=; _vis=; _yes=0; _check=0; _force=0; _brief=0
    while [ $# -gt 0 ]; do
        case $1 in
            --provider) shift; [ $# -ge 1 ] || die "$(t cli_pub_err_provider_arg)"; _prov=$1 ;;
            --provider=*) _prov=${1#--provider=} ;;
            --url) shift; [ $# -ge 1 ] || die "$(t cli_pub_err_url_arg)"; _url=$1; _prov=url ;;
            --url=*) _url=${1#--url=}; _prov=url ;;
            --name) shift; [ $# -ge 1 ] || die "$(t cli_pub_err_name_arg)"; _name=$1 ;;
            --name=*) _name=${1#--name=} ;;
            --private) _vis=private ;;
            --public)  _vis=public ;;
            --yes|-y)  _yes=1 ;;
            --check|--dry-run) _check=1 ;;
            --brief) _brief=1 ;;
            --force)   _force=1 ;;
            -*) die "$(t cli_pub_err_flag flag="$1")" ;;
            *)  die "$(t cli_pub_err_extra arg="$1")" ;;
        esac
        shift
    done
    [ -z "$_prov" ] || publish_provider_known "$_prov" ||
        die "$(t cli_pub_err_provider prov="$_prov")"

    _root=$(pwd -P)
    command -v git >/dev/null 2>&1 || die "$(t cli_pub_err_no_git)"
    verb_is_git "$_root" ||
        die "$(t cli_pub_err_no_repo)"

    # --brief: the same agent task, but on demand, not only inside a refusal. After a risk
    # has been accepted the cleanup is usually ordered later — and then it needs something
    # to order it with.
    if [ "$_brief" = 1 ]; then
        publish_scan "$_root"
        if [ "$(pub_count "$PUB_STOP")" -eq 0 ]; then
            ok "$(t cli_pub_nothing_to_clean)"
            exit 0
        fi
        publish_brief_secret "$_root"
        exit 0
    fi

    # --check: reconnaissance without network. This is also the mode for the agent: it can
    # look and report, but sending is still started by the human.
    if [ "$_check" = 1 ]; then
        publish_deps_report
        say ""
        if [ -z "$(publish_head "$_root")" ]; then
            warn "$(t cli_pub_no_commits)"
            exit 1
        fi
        _have=$(publish_remote_url "$_root")
        if [ -n "$_have" ]; then
            say "$(t cli_pub_copy url="$_have")"
            # Everything known here is THIS machine's memory of past pushes. The
            # reconnaissance runs without network (the agent runs it too, and it must neither
            # hang on an unreachable host nor go outside unasked), so the limit is said out loud.
            if [ -z "$(git -C "$_root" for-each-ref --count=1 refs/remotes 2>/dev/null)" ]; then
                warn "$(t cli_pub_never_pushed)"
            else
                _n=$(publish_unpushed "$_root")
                if [ "$_n" -gt 0 ]; then
                    say "  $(t cli_pub_unpushed n="$_n")"
                else
                    say "  $(t cli_pub_all_pushed)"
                fi
            fi
            dim "  $(t cli_pub_host_needs_net)"
        else
            say "$(t cli_pub_no_copy)"
        fi
        say ""
        publish_scan "$_root"
        publish_scan_show
        _stops=$(pub_count "$PUB_STOP")
        if [ "$_stops" -gt 0 ]; then
            say ""
            dim "  $(t cli_pub_risk_private)"
            dim "  $(t cli_pub_risk_public)"
            exit 1
        fi
        exit 0
    fi

    [ -n "$(publish_head "$_root")" ] ||
        die "$(t cli_pub_no_commits)
    $(t cli_pub_save_and_retry)"

    # There is a remote — so the question "did everything leave" is answered by the HOST,
    # not by our refs/remotes. This is exactly where an unfinished setup is caught: the
    # repository was created, the address was set, but no history is there. Local
    # bookkeeping in that case stays silent or lies.
    _have=$(publish_remote_url "$_root")
    if [ -n "$_have" ]; then
        _branch=$(publish_branch "$_root")
        dim "  $(t cli_pub_asking_host)"
        publish_host_state "$_root" "$_branch"
        # The host did not accept access over this address — fix the transport BEFORE the
        # plan. The human must ratify the address the copy will actually travel over, not
        # the one they were already refused on; the repository stays the same.
        if [ "$PUB_HOST" = denied ] && publish_transport_https "$_root"; then
            _have=$(publish_remote_url "$_root")
            publish_host_state "$_root" "$_branch"
        fi
        case $PUB_HOST in
            synced)
                ok "$(t cli_pub_synced url="$_have")"
                exit 0 ;;
            diverged)
                publish_refuse_diverged "$_root" "$_have" "$_branch"
                exit 2 ;;
            # empty / behind / unreachable are stated by the "on the host" line in the plan
            # itself — the one place where the human already reads the state. Saying the
            # same thing again on top is noise, and noise teaches people to scroll past.
        esac
    fi

    # The fork. We ask only where we have no answer and cannot have one.
    if [ -z "$_have" ]; then
        if [ -z "$_prov" ]; then
            if [ -t 0 ] && [ -t 1 ]; then
                _prov=$(publish_ask_provider) || die "$(t cli_pub_err_choice)"
            else
                publish_deps_report
                say ""
                die "$(t cli_pub_err_no_target)"
            fi
        fi
        if [ "$_prov" = url ] && [ -z "$_url" ]; then
            if [ -t 0 ] && [ -t 1 ]; then
                _url=$(publish_ask_url) || die "$(t cli_pub_err_no_url)"
            else
                die "$(t cli_pub_err_url_needed)"
            fi
        fi
        if [ "$_prov" != url ] && [ -z "$_vis" ]; then
            if [ -t 0 ] && [ -t 1 ]; then
                _vis=$(publish_ask_visibility)
            else
                # There is one default and it is private: publicity must never come from
                # silence — only from an explicit --public (P0, D3).
                _vis=private
            fi
        fi
    fi
    [ -n "$_vis" ] || _vis=host
    if [ -z "$_name" ]; then
        _name=$(publish_repo_name "$(basename -- "$_root")")
        [ "$_name" = "$(basename -- "$_root")" ] ||
            dim "  $(t cli_pub_repo_name name="$_name")"
    fi

    publish_scan "$_root"
    say ""
    publish_plan_show "$_root" "$_prov" "$_name" "$_url" "$_vis"
    say ""

    # What decides is not the finding but who will read it. A public repository — stop:
    # such a risk would not be one person's to accept. A private one — ratification: the
    # findings are named one by one, the "yes" is separate and every time, but no wall.
    _stops=$(pub_count "$PUB_STOP")
    _accept=0
    if [ "$_stops" -gt 0 ] && [ "$_force" = 0 ]; then
        publish_visibility_effective "$_root" "$_vis" "$_prov"
        if [ "$PUB_VIS" = unknown ] && [ -t 0 ] && [ -t 1 ]; then
            PUB_VIS=$(publish_ask_private)
            PUB_VIS_SRC=$(t cli_pub_vis_src_yours)
        fi
        case $PUB_VIS in
            private)
                publish_accept_notice "$_stops"
                _accept=1 ;;
            *)
                # Not advice but a ready task: "remove the file from history" is a request for
                # expertise the user may not have, which is exactly what P0 forbids a
                # procedure to assume.
                publish_refuse_secret "$_root" "$PUB_VIS"
                exit 2 ;;
        esac
    elif [ "$_stops" -gt 0 ]; then
        warn "$(t cli_pub_force_warn)"
    fi

    if [ "$_yes" = 0 ]; then
        if [ -t 0 ]; then
            if [ "$_accept" = 1 ]; then
                printf '  %s ' "$(t cli_pub_ask_with_findings)"
            else
                printf '  %s ' "$(t cli_pub_ask)"
            fi
            read -r _ans || _ans=
            case $_ans in
                y|Y|д|Д|yes|да) ;;
                *)
                    # "No" specifically on the findings question means "I want it, but clean",
                    # and the answer to that is a task for the agent, not the one word "cancelled".
                    if [ "$_stops" -gt 0 ]; then
                        publish_cancel_findings "$_root"
                    else
                        say "  $(t cli_cancelled)"
                    fi
                    exit 0 ;;
            esac
        else
            dim "  $(t cli_pub_plan_only)"
            exit 0
        fi
    fi

    publish_do "$_root" "$_prov" "$_name" "$_url" "$_vis" || exit 1
    exit 0
}

# --- clean ------------------------------------------------------------------
# One pass instead of thirty commands. Ratification does not disappear: the plan is always
# shown, and nothing is done without a "yes" — under a pipe "yes" is --yes, otherwise the
# cleanup only shows.
cmd_clean() {
    _yes=0
    for _a in "$@"; do
        case $_a in
            --yes|-y) _yes=1 ;;
            --dry-run) _yes=0 ;;
            *) die "$(t cli_err_unknown_flag flag="$_a")" ;;
        esac
    done
    _root=$(pwd -P)
    wm_managed "$_root" || die "$(t cli_clean_err_unmanaged)"
    clean_scan "$_root"
    clean_show || return 0
    say ""
    if [ "$_yes" = 0 ]; then
        if [ -t 0 ]; then
            printf '  %s ' "$(t cli_clean_ask)"
            read -r _ans || _ans=
            case $_ans in y|Y|д|Д|yes|да) ;; *) say "  $(t cli_cancelled)"; return 0 ;; esac
        else
            dim "  $(t cli_clean_plan_only)"
            return 0
        fi
    fi
    clean_apply "$_root"
}

# --- config -----------------------------------------------------------------
config_section_title() { t "cfg_sec_$1"; }

# Keys of one family set in either file, one per line, unique.
config_family_keys() {
    _cfk_root=$2
    { [ -n "$_cfk_root" ] && cat "$(config_project_file "$_cfk_root")" 2>/dev/null
      cat "$(config_machine_file)" 2>/dev/null; } |
        sed -n "s/^[[:space:]]*\($1[A-Za-z0-9_-]*\)[[:space:]]*=.*/\1/p" | awk '!seen[$0]++'
}

config_show_key() {
    _csk_v=$(config_get "$1" "$2")
    _csk_s=$(config_source "$1" "$2")
    printf '  %s %s %s← %s%s\n' "$(wm_pad "$1" 22)" "$(wm_pad "${_csk_v:-—}" 6)" "$C_DIM" "$_csk_s" "$C_OFF"
    [ -n "${3:-}" ] && printf '    %s%s%s\n' "$C_DIM" "$3" "$C_OFF"
    return 0
}

config_show() {
    _cs_root=$(pwd -P)
    project_is_managed "$_cs_root" || _cs_root=
    say "${C_BLD}$(t cfg_show_title)${C_OFF}"
    [ -n "$_cs_root" ] && dim "  $(t cfg_show_project path="$_cs_root")" || dim "  $(t cfg_show_outside)"
    for _cs_sec in general watchman saving models fleet expert; do
        say ""
        say "${C_BLD}$(config_section_title "$_cs_sec")${C_OFF}"
        config_table | while IFS='|' read -r _cs_k _cs_def _cs_s _cs_t; do
            [ "$_cs_s" = "$_cs_sec" ] || continue
            config_show_key "$_cs_k" "$_cs_root" "$(config_describe "$_cs_k")"
        done
        config_families | while IFS='|' read -r _cs_p _cs_s; do
            _cs_desc=$(t "cfg_fam_${_cs_p%_}")
            [ "$_cs_s" = "$_cs_sec" ] || continue
            _cs_keys=$(config_family_keys "$_cs_p" "$_cs_root")
            if [ -z "$_cs_keys" ]; then
                printf '  %s %s—%s\n' "$(wm_pad "${_cs_p}…" 22)" "$C_DIM" "$C_OFF"
            else
                for _cs_fk in $_cs_keys; do config_show_key "$_cs_fk" "$_cs_root"; done
            fi
            printf '    %s%s%s\n' "$C_DIM" "$_cs_desc" "$C_OFF"
        done
        [ "$_cs_sec" = models ] && dim "    $(t cfg_show_roles_hint)"
    done
    say ""
    dim "  $(t cfg_show_hint_set)"
    dim "  $(t cfg_show_hint_machine)"
    dim "  $(t cfg_show_hint_unset)"
}

# What a key accepts, in words: "on or off", "a number", "notify or off".
config_type_words() {
    case $(config_type "$1") in
        on/off) t cfg_type_onoff ;;
        int)    t cfg_type_int ;;
        lang)   t cfg_type_lang codes="$(i18n_languages | cut -d'|' -f1 | tr '\n' ' ' | sed 's/ $//')" ;;
        enum:*) _ctw=$(config_type "$1"); printf '%s' "${_ctw#enum:}" | sed "s/,/ $(t cfg_type_or) /g" ;;
        *)      t cfg_type_text ;;
    esac
}

# Check a key and value before writing. Dies with the reason.
config_check_set() {
    _ccs_k=$1; _ccs_v=$2
    if config_known "$_ccs_k"; then
        config_valid "$_ccs_k" "$_ccs_v" ||
            die "$(t cfg_err_value value="$_ccs_v" key="$_ccs_k" need="$(config_type_words "$_ccs_k")")"
        return 0
    fi
    case $(config_family "$_ccs_k") in
        tier_|role_)
            roles_parse "$_ccs_v" >/dev/null || die "$(t cfg_err_role value="$_ccs_v")"
            return 0 ;;
        ?*) return 0 ;;
    esac
    if _ccs_new=$(config_replacement "$_ccs_k"); then
        [ -n "$_ccs_new" ] || die "$(t cfg_err_always_on key="$_ccs_k")"
        die "$(t cfg_err_replaced key="$_ccs_k" new="$_ccs_new")"
    fi
    die "$(t cfg_err_unknown key="$_ccs_k")"
}

cmd_config() {
    case ${1:-show} in
        show|"") config_show ;;
        set|unset)
            _cc_op=$1; shift
            _scope=project
            if [ "${1:-}" = --machine ]; then _scope=machine; shift; fi
            if [ "$_cc_op" = set ]; then
                [ $# -ge 2 ] || die "$(t cfg_err_usage_set)"
                _k=$1; _v=$2
                config_check_set "$_k" "$_v"
            else
                [ $# -ge 1 ] || die "$(t cfg_err_usage_unset)"
                _k=$1
            fi
            # The operator's own settings (language, updates) live on the machine whatever
            # the flag: a project travels to other people.
            [ "$(config_section "$_k")" = general ] && _scope=machine
            if [ "$_scope" = machine ]; then
                _cc_f=$(config_machine_file); _cc_where='~/.fraim/config'
            else
                _root=$(pwd -P)
                project_is_managed "$_root" ||
                    die "$(t cfg_err_not_project)"
                _cc_f=$(config_project_file "$_root"); _cc_where=ai/fraim.conf
            fi
            if [ "$_cc_op" = set ]; then
                config_set_file "$_cc_f" "$_k" "$_v" || die "$(t cfg_err_write)"
                ok "$_k = $_v → $_cc_where"
            else
                config_unset_file "$_cc_f" "$_k" || die "$(t cfg_err_write)"
                ok "$(t cfg_unset_done key="$_k" where="$_cc_where")"
            fi
            ;;
        *) die "$(t cfg_err_subcommand sub="$1")" ;;
    esac
}

# --- deterministic verbs ----------------------------------------------------
# Each one replaces a block of prose that used to ask the model to perform a
# mechanical action by hand. See installer/DETERMINISM.md.
# The project root is the nearest directory upward that holds ai/ — an agent standing in
# src/ is still in the project, and a verb that refused there would be retyped by hand.
verb_root() {
    _vr=$(pwd -P)
    while [ ! -d "$_vr/ai" ]; do
        [ "$_vr" = / ] && die "$(t cli_err_not_project)"
        _vr=$(dirname -- "$_vr")
    done
    printf '%s\n' "$_vr"
}

cmd_tasks()       { verb_tasks "$(verb_root)" "${1:-}"; }
cmd_task_new()    { verb_task_new "$(verb_root)" "$@"; }
cmd_task_master() { verb_task_master "$(verb_root)" "${1:-}"; }
cmd_task_seal()   { verb_task_seal "$(verb_root)" "$@"; }
cmd_backlog()      { verb_backlog "$(verb_root)"; }
cmd_backlog_new()  { verb_backlog_new "$(verb_root)" "$@"; }
cmd_backlog_drop() { verb_backlog_drop "$(verb_root)" "$@"; }
cmd_brief()        { verb_brief "$(verb_root)"; }
cmd_find()         { verb_find "$(verb_root)" "$@"; }
cmd_arch()         { verb_arch "$(verb_root)" "$@"; }

# Verbs of the old plan handoff. A task is a card now, and nothing about it can go stale
# or be blocked — but procedures from an older install and agents with a long memory will
# still call these. They get one sentence saying where the thing went, never a silent
# "unknown command" that reads like a broken install.
cmd_retired_task_verb() {
    die "$(t cli_retired_verb verb="$1")"
}

# The body of a decision arrives on stdin, never through argv: a multi-line entry
# squeezed into a command-line argument is how a verb starts shortening content it
# has no business touching. The verb owns placement, heading and date — nothing else.
cmd_decide() {
    [ $# -ge 1 ] || die "$(t cli_decide_usage)"
    _title=$1; shift
    _sup=
    if [ "${1:-}" = --supersedes ]; then
        [ $# -ge 2 ] || die "$(t cli_decide_err_sup)"
        _sup=$2
    fi
    verb_decide "$(verb_root)" "$_title" "$_sup"
}

cmd_pitfall() { verb_pitfall "$(verb_root)" "$@"; }

cmd_investigate_new()  { [ $# -ge 1 ] || die "$(t cli_inv_err_slug)"; verb_investigate_new  "$(verb_root)" "$1"; }
cmd_investigate_seal() { [ $# -ge 1 ] || die "$(t cli_inv_err_slug)"; verb_investigate_seal "$(verb_root)" "$1"; }

# The save point, by explicit path list. There is deliberately no way to say "everything":
# `git add .` in a folder the system did not lay down is how secrets and data directories
# get committed, and the person least able to notice that is the one this product is for.
# A verb commits what it touched, and nothing else.
cmd_commit() {
    [ $# -ge 3 ] || die "$(t cli_commit_usage)"
    _kind=$1; _text=$2
    shift 2
    printf '%s' "$_kind" | grep -qE '^[a-z][a-z-]*$' ||
        die "$(t cli_commit_err_kind)"
    lang_check "the commit message" "$_text"
    _root=$(pwd -P)
    verb_is_git "$_root" || die "$(t cli_commit_err_no_git)"
    lang_check_commit "$_root" "$@"
    verb_commit "$_root" "$_kind" "$_text" "$@" || die "$(t cli_commit_failed)"
}
cmd_prune_mark() { verb_prune_mark "$(verb_root)"; }
cmd_stack_passport() { verb_stack_passport "$(pwd -P)"; }
cmd_undo() {
    _root=$(pwd -P)
    if [ $# -ge 1 ]; then verb_undo "$_root" "$1"; else verb_undo_show "$_root"; fi
}
cmd_restore() { verb_restore "$(pwd -P)" "$@"; }

# Dispatch: split a task into parallel subtasks for independent workers.
# Takes an optional plan file; without it, looks for build-plan.md in project.
# The mechanics of a build. Called by the conductor agent — the human types none of these.
# They say what they want and read what came back; every step in between, `accept` (check
# behind the workers, run the project's check, clean up, write the trunk, report) included,
# is the agent's. The human's judgement comes after, in words, and its lever is
# `fraim undo <merge>` — which the agent runs too.
cmd_dispatch() {
    _sub=${1:-}

    # `check` is the one subcommand that reads a file and writes nothing, so it must
    # work where a plan is written — which is not always inside a project. Without a
    # project the role table simply resolves one level up, from the machine.
    if [ "$_sub" = check ]; then
        [ $# -ge 2 ] || die "$(t cli_disp_usage_check)"
        _root=$(pwd -P); [ -d "$_root/ai" ] || _root=
        dispatch_check "$2" "$_root" || die "$(t cli_disp_err_plan_bad)"
        ok "$(t cli_disp_check_ok)"
        say ""
        # What this build costs, before a single worker starts. Warnings first, because a
        # plan that passes the checks can still be a build nobody can accept in one sitting.
        dispatch_size_notes "$2"
        say "$(dispatch_cost_line "$2")"
        say ""
        dispatch_report "$2" "$_root"
        return 0
    fi

    _root=$(verb_root)
    case $_sub in
        verify)
            [ $# -ge 3 ] || die "$(t cli_disp_usage_verify)"
            _b=$2; _s=$3
            _plan="$_root/ai/builds/$_b/plan.md"
            [ -f "$_plan" ] || die "$(t cli_disp_err_no_build_plan build="$_b")"
            _paths=$(dispatch_field "$_plan" "$_s" 4)
            [ -n "$_paths" ] || die "$(t cli_disp_err_no_subtask build="$_b" sub="$_s")"
            _base=${4:-$(cd "$_root" && git rev-parse HEAD 2>/dev/null)}

            # The worker's own checkout, not the project root — see dispatch_worker_tree.
            # Falling back to the root when there is no checkout keeps the command useful
            # for work done by hand in place, which is how it is used without an ADE.
            _tree=$(dispatch_worker_tree "$_root" "$_b-$_s")
            if [ -n "$_tree" ]; then
                dim "  $(t cli_disp_checkout path="$_tree")"
            else
                _tree=$_root
                warn "$(t cli_disp_no_checkout name="$_b-$_s")"
            fi
            dispatch_verify_tree "$_tree" "$_base" "$_paths"
            ;;
        run)
            [ $# -ge 2 ] || die "$(t cli_disp_usage_run)"
            say "$(t cli_disp_launching build="$2")"
            if dispatch_launch "$_root" "$2" "${3:-}"; then
                say ""
                ok "$(t cli_disp_launched)"
                dim "    $(t cli_disp_hint_watch build="$2")"
                dim "    $(t cli_disp_hint_collect build="$2")"
            else
                say ""
                warn "$(t cli_disp_launch_partial build="$2")"
                exit 1
            fi
            ;;
        watch)
            [ $# -ge 2 ] || die "$(t cli_disp_usage_watch)"
            build_fleet_rows "$_root" "$2" | while IFS='	' read -r _s _t _d _at; do
                if [ -z "$_d" ] || [ "$_d" = "—" ]; then
                    printf '%-12s %s\n' "$_s" "$(t cli_disp_watch_not_up)"; continue
                fi
                _w=$(fleet_worker_show "$_d")
                # Their two words for how a worker is doing. Pulled out rather than
                # printing raw JSON — the first live build showed the operator a wall of
                # it — but the raw answer still shows when neither word is found, because
                # inventing a verdict we did not read would be worse than a wall (§9.5).
                _st=$(printf '%s' "$_w" | tr -d '\n' |
                      grep -oE '"state"[[:space:]]*:[[:space:]]*"[a-z_]*"' | head -1 |
                      sed 's/.*"\([a-z_]*\)"$/\1/')
                _sg=$(printf '%s' "$_w" | tr -d '\n' |
                      grep -oE '"stage"[[:space:]]*:[[:space:]]*"[a-z_]*"' | head -1 |
                      sed 's/.*"\([a-z_]*\)"$/\1/')
                if printf '%s' "$_w" | fleet_ok && [ -n "$_st$_sg" ]; then
                    printf '%-12s %-18s %s %s\n' "$_s" "$_d" "${_st:-—}" "${_sg:+· $_sg}"
                else
                    printf '%-12s %-18s %s\n' "$_s" "$_d" "$(t cli_disp_watch_unexpected)"
                    printf '%s\n' "$_w" | head -4 | sed 's/^/    /'
                fi
            done
            say ""
            dim "    $(t cli_disp_watch_note_terminal)"
            dim "    $(t cli_disp_watch_note_verify)"
            ;;
        collect)
            [ $# -ge 2 ] || die "$(t cli_disp_usage_collect)"
            if dispatch_collect "$_root" "$2" "${3:-}"; then
                say ""
                ok "$(t cli_disp_collected branch="$(build_branch "$2")")"
                if _next=$(build_next_wave "$_root" "$2"); then
                    dim "    $(t cli_disp_next_wave build="$2")"
                    dim "    $(t cli_disp_next_wave_note wave="$_next")"
                else
                    dim "    $(t cli_disp_all_collected)"
                    dim "    $(t cli_disp_accept_hint build="$2")"
                fi
            else
                say ""
                die "$(t cli_disp_err_collect_partial)"
            fi
            ;;
        accept)
            # The whole of the acceptance, and all of it the conductor's: check behind every
            # worker, run the project's check on the assembled branch, clean up after the
            # fleet, write the trunk, print the report. The human types nothing — they read
            # this output and answer in words (MODES.md §4, option B).
            [ $# -ge 2 ] || die "$(t cli_disp_usage_accept)"
            _arc=0
            build_accept "$_root" "$2" || _arc=$?
            [ "$_arc" -eq 2 ] && die "$(t cli_disp_err_accept)"
            say ""
            if [ "$_arc" -eq 0 ]; then
                ok "$(t cli_disp_accepted build="$2")"
                # Addressed to the conductor agent, not the operator: English, inline.
                dim "    show the human what is above, and say in your own words what the numbers"
                dim "    do not show and what you are unsure of — the human decides"
            else
                warn "$(t cli_disp_not_accepted build="$2")"
                exit 1
            fi
            ;;
        list)
            build_list "$_root"
            ;;
        "")
            die "$(t cli_disp_usage)"
            ;;
        *)
            _plan=$_sub
            [ -f "$_plan" ] || die "$(t cli_disp_err_no_plan path="$_plan")"
            dispatch_check "$_plan" "$_root" || die "$(t cli_disp_err_plan_bad)"
            dispatch_size_notes "$_plan"

            _bid=build-$(date -u '+%Y%m%d-%H%M%S')
            build_seal "$_root" "$_bid" "$_plan" >/dev/null || die "$(t cli_disp_err_journal)"

            say "$(t cli_disp_build_title build="$_bid")"
            say ""
            dispatch_report "$_plan" "$_root"
            say ""

            dispatch_parse_plan "$_plan" | while IFS='|' read -r _id _role _sum _paths; do
                [ -n "$_id" ] || continue
                _d=$(dispatch_write_task "$_root" "$_bid" "$_id" "$_role" "$_sum" "$_paths") ||
                    die "$(t cli_disp_err_write_task id="$_id")"
                dim "  $(t cli_disp_task_written id="$_id" path="${_d#"$_root"/}")"
            done

            say ""
            ok "$(t cli_disp_tasks_done build="$_bid")"
            if fleet_present; then
                dim "    $(t cli_disp_plan_hint_run build="$_bid")"
                dim "    $(t cli_disp_hint_watch build="$_bid")"
            else
                dim "    $(t cli_disp_plan_no_ade)"
            fi
            dim "    $(t cli_disp_plan_hint_collect build="$_bid")"
            dim "    $(t cli_disp_plan_hint_verify build="$_bid")"
            ;;
    esac
}

# Interactive assignment. The point is P0: nobody should have to remember that the value
# is three colon-separated fields, nor type a model id from memory. Where a list can be
# had it is offered; where it cannot, a typed value is still accepted — see roles.sh for
# why we do not keep a catalogue of models.
cmd_roles_set() {
    _rs_root=$(pwd -P)
    project_is_managed "$_rs_root" || _rs_root=

    _rs_force_machine=
    if [ "${1:-}" = --machine ]; then _rs_force_machine=1; shift; fi

    # Non-interactive form: `fraim roles set KEY VALUE`. This is the path a Dockerfile
    # or a VM recipe takes — an image is built without a terminal, and baking the role
    # table into the image is the whole point of building one. `fraim config set` cannot
    # do it: it validates the key against config_table, and role_/tier_ keys are open-ended
    # by design, so it refuses every one of them.
    if [ $# -ge 2 ]; then
        _rs_key=$1; _rs_val=$2
        case $_rs_key in
            tier_*|role_*) ;;
            *) _rs_key=role_$_rs_key ;;
        esac
        roles_parse "$_rs_val" >/dev/null ||
            die "$(t cli_roles_err_form value="$_rs_val")"
        if [ -n "$_rs_force_machine" ] || [ -z "$_rs_root" ]; then
            _rs_file=$(config_machine_file)
        else
            _rs_file=$(config_project_file "$_rs_root")
        fi
        config_set_file "$_rs_file" "$_rs_key" "$_rs_val" || die "$(t cli_roles_err_write path="$_rs_file")"
        ok "$_rs_key = $_rs_val"
        dim "    → $_rs_file"
        return 0
    fi

    menu_supported || die "$(t cli_roles_err_no_tty)"

    # 1. Which procedure. A tier key is offered too, because setting tier_cheap once is
    #    usually the right move and setting thirteen roles one by one is usually not.
    if [ $# -ge 1 ]; then
        _rs_key=$1
    else
        _rs_key=$({ printf 'tier_cheap\ntier_capable\ntier_strong\n'
                    fraim_procedures 2>/dev/null || :
                  } | roles_pick "$(t cli_roles_pick_key)") ||
            die "$(t cli_cancelled)"
    fi
    case $_rs_key in
        tier_*) _rs_ckey=$_rs_key ;;
        role_*) _rs_ckey=$_rs_key ;;
        *)      _rs_ckey=role_$_rs_key ;;
    esac

    # 2-4. The three fields. The agent list comes from harness_detect (harness.sh) —
    #      the harnesses fraim knows about and that are present on this machine,
    #      independent of any execution environment. Models offered are the live
    #      catalogue of THIS agent (roles_models_of asks the agent's own channel —
    #      see roles.sh), plus the ones already configured here and the tier
    #      suggestion, so the first run has something to pick even where the agent
    #      cannot be asked.
    _rs_agent=$(roles_agents_available | roles_pick "$(t cli_roles_pick_agent)" 1) || die "$(t cli_cancelled)"
    case $_rs_key in
        tier_*) _rs_tier=${_rs_key#tier_} ;;
        *)      _rs_tier=$(roles_tier_of "${_rs_key#role_}" 2>/dev/null || :) ;;
    esac
    _rs_model=$({ roles_models_of "$_rs_agent"; roles_models_seen "$_rs_root"; roles_models_suggested "$_rs_tier"; } |
                grep '[^[:space:]]' | awk '!seen[$0]++' |
                roles_pick "$(t cli_roles_pick_model)" 1) || die "$(t cli_cancelled)"
    _rs_effort=$(roles_efforts_of "$_rs_agent" "$_rs_model" | roles_pick "$(t cli_roles_pick_effort)" 2) || die "$(t cli_cancelled)"

    _rs_val="$_rs_agent:$_rs_model:$_rs_effort"
    roles_parse "$_rs_val" >/dev/null || die "$(t cli_roles_err_result value="$_rs_val")"

    # 5. Which level. Project beats machine (§11.3, C), so the question is real whenever
    #    we are standing inside a project.
    _rs_file=$(config_machine_file)
    if [ -n "$_rs_root" ]; then
        _rs_lvl=$(printf '%s\n%s\n' "$(t cli_roles_level_machine)" "$(t cli_roles_level_project)" |
                  roles_pick "$(t cli_roles_pick_level)" 1) || die "$(t cli_cancelled)"
        case $_rs_lvl in
            *fraim.conf*) _rs_file=$(config_project_file "$_rs_root") ;;
        esac
    fi

    config_set_file "$_rs_file" "$_rs_ckey" "$_rs_val" || die "$(t cli_roles_err_write path="$_rs_file")"
    say ""
    ok "$_rs_ckey = $_rs_val"
    dim "    → $_rs_file"
}

# The retired project mode (DECISIONS 2026-09-15). There is one way of working — the
# agent does the work in the conversation — and the conductor is a procedure the human
# asks for, not a role a project switch assigns. Projects switched into the fleet before
# that still carry three leftovers; this verb removes exactly those and nothing else (B6):
# the `mode` line in ai/fraim.conf, the conductor section in AGENTS.md (gone by itself once
# the project block is rewritten) and the SessionStart hook in .claude/settings.json.
cmd_mode() {
    # A leftover hook calls this at every session start. It must stay silent and green.
    [ "${1:-}" = --hook ] && return 0

    _md_root=$(verb_root)
    say "$(t cli_mode_gone)"
    dim "    $(t cli_mode_conductor_note)"
    say ""

    _md_did=
    _md_conf=$(config_project_file "$_md_root")
    if [ -n "$(config_read_file "$_md_conf" mode)" ]; then
        _md_tmp="$_md_conf.fraim.$$"
        grep -v '^[[:space:]]*mode[[:space:]]*=' "$_md_conf" > "$_md_tmp" && mv "$_md_tmp" "$_md_conf" ||
            die "$(t cli_mode_err_conf)"
        ok "$(t cli_mode_conf_done)"; _md_did=1
    fi

    if [ -f "$_md_root/AGENTS.md" ] && grep -q '^## Fleet mode is on' "$_md_root/AGENTS.md"; then
        context_install "$_md_root/AGENTS.md" context_project_block ||
            die "$(t cli_mode_err_agents)"
        ok "$(t cli_mode_agents_done)"; _md_did=1
    fi

    if context_hook_remove "$_md_root"; then
        ok "$(t cli_mode_hook_done)"; _md_did=1
    else
        case $? in
            2) warn "$(t cli_mode_hook_no_python mark="$CTX_HOOK_MARK")" ;;
            1) warn "$(t cli_mode_hook_unreadable mark="$CTX_HOOK_MARK")" ;;
        esac
    fi

    [ -n "$_md_did" ] || dim "    $(t cli_mode_nothing)"
    return 0
}

# cli_pad TEXT WIDTH — TEXT padded with spaces to WIDTH terminal columns.
cli_pad() {
    _cp_n=$(str_width "$1")
    printf '%s' "$1"
    while [ "$_cp_n" -lt "$2" ]; do printf ' '; _cp_n=$((_cp_n + 1)); done
}

# The role table (MODES.md §11.3): what a role resolves to here, and from which level.
cmd_roles() {
    if [ "${1:-}" = set ]; then shift; cmd_roles_set "$@"; return; fi
    _root=$(pwd -P)
    project_is_managed "$_root" || _root=
    _rs=$(roles_list "$_root")
    if [ -z "$_rs" ]; then
        say "$(t cli_roles_none)"
        printf '  %s\n' "$(roles_resolve default "$_root" | tr '\t' ' ')"
        say ""
        dim "    $(t cli_roles_set_hint)"
        return 0
    fi
    # Padded by display width, not with printf: POSIX printf pads to BYTES, and the headings
    # come from the catalog — %-15s on the 4-letter Cyrillic word for «role» pads 8 bytes to
    # 15 and lands 4 characters wide. The widths match the row format below.
    printf '%s %s %s %s %s\n' "$(cli_pad "$(t cli_roles_col_role)" 15)" \
        "$(cli_pad "$(t cli_roles_col_agent)" 7)" "$(cli_pad "$(t cli_roles_col_model)" 8)" \
        "$(cli_pad "$(t cli_roles_col_effort)" 7)" "$(t cli_roles_col_source)"
    for _r in $_rs; do
        _ex=$(roles_resolve "$_r" "$_root") || continue
        _ra=$(printf '%s' "$_ex" | cut -f1)
        _rnote=$(fleet_caps_describe "$_ra" 2>/dev/null || :)
        printf '%-15s %-7s %-8s %-7s %s%s\n' "$_r" \
            "$_ra" \
            "$(printf '%s' "$_ex" | cut -f2)" \
            "$(printf '%s' "$_ex" | cut -f3)" \
            "$(roles_source "$_r" "$_root")" \
            "${_rnote:+  ← $_rnote}"
    done
}

# --- dispatch ---------------------------------------------------------------
# A bare `fraim` is the most common thing typed by someone who does not know
# what to type — answering it with a list of twenty commands is the worst
# available reply. On a terminal it opens the menu; through a pipe (an agent,
# cron, CI) it prints the usage exactly as before.
[ $# -ge 1 ] || { menu_run; exit 0; }
_cmd=$1; shift
case $_cmd in
    menu)          menu_run ;;
    init)          cmd_init "$@" ;;
    update)        cmd_update "$@" ;;
    scaffold)      cmd_scaffold "$@" ;;
    upgrade)       cmd_upgrade "$@" ;;
    clean)         cmd_clean "$@" ;;
    publish)       cmd_publish "$@" ;;
    config)        cmd_config "$@" ;;
    tasks)         cmd_tasks "$@" ;;
    task-new)      cmd_task_new "$@" ;;
    task-master)   cmd_task_master "$@" ;;
    task-seal)     cmd_task_seal "$@" ;;
    backlog)       cmd_backlog "$@" ;;
    backlog-new)   cmd_backlog_new "$@" ;;
    backlog-drop)  cmd_backlog_drop "$@" ;;
    brief)         cmd_brief "$@" ;;
    find)          cmd_find "$@" ;;
    arch)          cmd_arch "$@" ;;
    task-block|task-result|task-revise|plan-seal|reconcile-seal)
                   cmd_retired_task_verb "$_cmd" ;;
    decide)        cmd_decide "$@" ;;
    pitfall)       cmd_pitfall "$@" ;;
    investigate-new)  cmd_investigate_new "$@" ;;
    investigate-seal) cmd_investigate_seal "$@" ;;
    commit)        cmd_commit "$@" ;;
    undo)          cmd_undo "$@" ;;
    restore)       cmd_restore "$@" ;;
    prune-mark)    cmd_prune_mark "$@" ;;
    stack-passport) cmd_stack_passport "$@" ;;
    status)        cmd_status "$@" ;;
    fleet)         cmd_fleet "$@" ;;
    dispatch)      cmd_dispatch "$@" ;;
    roles)         cmd_roles "$@" ;;
    mode)          cmd_mode "$@" ;;
    projects)      cmd_projects "$@" ;;
    doctor)        cmd_doctor "$@" ;;
    show)          cmd_show "$@" ;;
    build)         cmd_build "$@" ;;
    version|--version|-v) cmd_version ;;
    help|--help|-h) usage ;;
    *) printf 'fraim: %s\n\n' "$(t cli_err_unknown_command cmd="$_cmd")" >&2; usage >&2; exit 2 ;;
esac
